BuildBExtNormalForms32 := function(g, f)
    local B, i, j;

    B := [];

    for i in [0..12] do
        for j in [0..5] do
            Add(B, rec(i := i, j := j, elt := g^i * f^j));
        od;
    od;

    return B;
end;;

BruhatWitnesses32 := function(g, f, t)
    local witnesses, i, j, b, bt;

    witnesses := [];

    for i in [0..12] do
        for j in [0..5] do
            b := g^i * f^j;
            bt := b * t;

            if bt <> One52Ext32 and bt^3 = One52Ext32 then
                Add(witnesses, [i, j]);
            fi;
        od;
    od;

    return witnesses;
end;;

