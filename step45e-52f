    coeffList := ProjectiveCoeffList56B(hdim, MAX_HOM_RANDOM_COMBOS56B);;

    Print("Coefficient directions to test = ", Length(coeffList), "\n");

    modules := [];;
    idx := 0;;

    for coeffs in coeffList do
