                ));

                Print("  FOUND GOOD LIE BRACKET COMBO: coeffs = ",
                      coeffs45E, ", rank = ", rank45E, "\n");
            fi;
        od;

        Print("Projective combinations tested = ", testedCombos45E, "\n");
        Print("Good Lie bracket combinations found = ", Length(goodCombos45E), "\n");
    fi;

    Add(All14BracketReports45E, rec(
        recordIndex := info45E.recordIndex,
        profile := info45E.profile,
        homDim := homDim45E,
        basisRanks := basisRanks45E,
        basisJacobiFailures := basisJacobi45E,
