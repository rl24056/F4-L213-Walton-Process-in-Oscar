############################################################
# Hom_H(A,B) for row-action modules
#
# A map X: A -> B sends row vector v to vX.
# Equivariance condition:
#
#       A_gen * X = X * B_gen
#
# We solve linear equations in entries of X.
############################################################

HomBasisRows50A := function(matsA, matsB)
    local dA, dB, nvars, varIndex, rows,
          gen, A, B, i, j, k, row;

    dA := Length(matsA[1]);
    dB := Length(matsB[1]);
    nvars := dA * dB;

    varIndex := function(r, s)
        return (r-1)*dB + s;
    end;

    rows := [];

    for gen in [1..Length(matsA)] do
        A := matsA[gen];
        B := matsB[gen];

        for i in [1..dA] do
            for j in [1..dB] do
                row := List([1..nvars], u -> zero45E);

                # coefficient from A*X
                for k in [1..dA] do
                    row[varIndex(k,j)] := row[varIndex(k,j)] + A[i][k];
                od;

                # coefficient from -X*B
                for k in [1..dB] do
                    row[varIndex(i,k)] := row[varIndex(i,k)] - B[k][j];
                od;

                Add(rows, row);
            od;
        od;
    od;

    # GAP NullspaceMat gives left nullspace, so transpose the equation matrix.
    return NullspaceMat(TransposedMat(rows));
end;;

HomDim50A := function(MrecA, MrecB)
