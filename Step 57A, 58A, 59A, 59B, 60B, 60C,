VectorFromSupport61 := function(support, coeffs)
    local v, r;

    v := List([1..27], i -> zero61);

    for r in [1..Length(support)] do
        v[support[r]] := coeffs[r];
    od;

    return v;
end;;

NonzeroCoeffTuples61 := function(len)
    local tuples, recfun, current, a;

    tuples := [];

    recfun := function(pos, current)
        local copy;

        if pos > len then
            if not ForAll(current, x -> x = zero61) then
                Add(tuples, ShallowCopy(current));
            fi;
            return;
        fi;

        for a in elts61 do
            copy := ShallowCopy(current);
            Add(copy, a);
            recfun(pos + 1, copy);
        od;
    end;

    recfun(1, []);

    return tuples;
end;;

