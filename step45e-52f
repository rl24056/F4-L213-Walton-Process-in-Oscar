BlockDiagList49A := function(listMats)
    local total, F, z, rows, offset, M, d, i, j, row;

    total := 0;

    for M in listMats do
        total := total + Length(M);
    od;

    F := DefaultFieldOfMatrix(listMats[1]);
    z := Zero(F);

    rows := [];
    for i in [1..total] do
        Add(rows, List([1..total], j -> z));
    od;

    offset := 0;

    for M in listMats do
        d := Length(M);

        for i in [1..d] do
            for j in [1..d] do
                rows[offset+i][offset+j] := M[i][j];
            od;
        od;

        offset := offset + d;
    od;

    return rows;
end;;

