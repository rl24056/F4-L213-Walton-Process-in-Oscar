TraceMat43A := function(A)
    local s, i;
    s := zero7_43A;
    for i in [1..Length(A)] do
        s := s + A[i][i];
    od;
    return s;
end;;

TraceLabel43A := function(x)
    if x = 0 * one7_43A then
        return "0";
    elif x = 1 * one7_43A then
        return "1";
    elif x = -1 * one7_43A then
        return "-1";
    elif x = 2 * one7_43A then
        return "2";
    elif x = -2 * one7_43A then
        return "-2";
    elif x = -4 * one7_43A then
        return "-4";
    else
        return String(x);
    fi;
end;;

ActionExponentCyclic43A := function(g, x)
    local gx, k, n;
    n := Order(g);
    gx := g^x;
    for k in [0..n-1] do
        if gx = g^k then
            return k;
        fi;
    od;
    return fail;
end;;

FindBruhatWitness43A := function(g, f, t)
    local i, j, b, bt, id;
    id := t^0;
    for i in [0..12] do
        for j in [0..5] do
            b := g^i * f^j;
            bt := b * t;
            if bt <> id and bt^3 = id then
                return rec(i := i, j := j, order := Order(bt));
            fi;
        od;
    od;
    return fail;
end;;

NormalFormsCount43A := function(g, f)
    local L, i, j;
    L := [];
    for i in [0..12] do
        for j in [0..5] do
            Add(L, g^i * f^j);
        od;
    od;
    return Length(Set(L));
end;;

BlockDiag2_43A := function(A, B)
    local n, m, C, i, j;
    n := Length(A);
    m := Length(B);
    C := NullMat(n + m, n + m, F7_43A);

    for i in [1..n] do
        for j in [1..n] do
            C[i][j] := A[i][j];
        od;
    od;

    for i in [1..m] do
        for j in [1..m] do
            C[n+i][n+j] := B[i][j];
        od;
    od;

    return C;
end;;

BlockDiagList43A := function(L)
    local total, M, C, offset, n, i, j;
    total := Sum(List(L, X -> Length(X)));
    C := NullMat(total, total, F7_43A);
    offset := 0;

    for M in L do
        n := Length(M);
        for i in [1..n] do
            for j in [1..n] do
                C[offset+i][offset+j] := M[i][j];
            od;
        od;
        offset := offset + n;
    od;

    return C;
end;;

TopLeftBlock43A := function(A, d)
    local C, i, j;
    C := NullMat(d, d, F7_43A);
    for i in [1..d] do
        for j in [1..d] do
            C[i][j] := A[i][j];
        od;
    od;
    return C;
end;;

BottomRightBlock43A := function(A, d)
    local n, m, C, i, j;
    n := Length(A);
    m := n - d;
    C := NullMat(m, m, F7_43A);
    for i in [1..m] do
        for j in [1..m] do
            C[i][j] := A[d+i][d+j];
        od;
    od;
    return C;
end;;

FixedDim43A := function(A)
    local N;
    N := NullspaceMat(A - A^0);
    return Length(N);
end;;

IsTarget26Trace43A := function(g, f, t)
    if TraceMat43A(g) <> 0 * one7_43A then
