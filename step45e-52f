############################################################
# Build fixed-space equation matrix for Sym^3(V26)
#
# Row vector c is fixed if:
#       c * Sym3(M) = c
# so:
#       c * (Sym3(M)-I) = 0
#
# We concatenate the equations horizontally.
############################################################

InvariantSymPowerData53A := function(mats, deg)
    local d, data, n, big, genNo, M, SM, i, r;

    d := Length(mats[1]);
    data := SymBasisData46A(d, deg);
    n := data.dim;

    Print("Sym^", deg, " dimension = ", n, "\n");

    big := List([1..n], i -> []);

    genNo := 0;

    for M in mats do
        genNo := genNo + 1;

        Print("  building Sym^", deg, " matrix for generator ", genNo, "\n");

        SM := SymPowerMatrix46A(M, data);

        for i in [1..n] do
            SM[i][i] := SM[i][i] - one45E;
        od;

        for r in [1..n] do
            Append(big[r], SM[r]);
        od;

        Print("  appended generator ", genNo, " equations\n");
    od;

    Print("computing fixed-space basis\n");

    return rec(
        data := data,
        big := big,
        basis := NullspaceMat(big),
        dim := Length(NullspaceMat(big))
    );
end;;

############################################################
# Classify monomial block type
#
# Coordinates 1..12 are the 12-block.
# Coordinates 13..26 are the 14-block.
############################################################

BlockType53A := function(mon)
    local count12, x;

    count12 := 0;

    for x in mon do
        if x <= 12 then
            count12 := count12 + 1;
        fi;
    od;

    if count12 = 3 then
        return "12^3";
    elif count12 = 2 then
        return "12^2*14";
    elif count12 = 1 then
        return "12*14^2";
    else
        return "14^3";
    fi;
end;;

TypeIndices53A := function(data, wanted)
    local inds, i, typ;

    inds := [];

    for i in [1..Length(data.basis)] do
        typ := BlockType53A(data.basis[i]);

        if typ in wanted then
            Add(inds, i);
        fi;
    od;

    return inds;
end;;

SupportCountsByType53A := function(vec, data)
    local counts, i, typ;

    counts := rec(
        t123 := 0,
        t1214 := 0,
        t121414 := 0,
        t143 := 0
    );

    for i in [1..Length(vec)] do
        if vec[i] <> zero45E then
            typ := BlockType53A(data.basis[i]);

            if typ = "12^3" then
                counts.t123 := counts.t123 + 1;
            elif typ = "12^2*14" then
                counts.t1214 := counts.t1214 + 1;
            elif typ = "12*14^2" then
                counts.t121414 := counts.t121414 + 1;
            elif typ = "14^3" then
                counts.t143 := counts.t143 + 1;
            fi;
        fi;
    od;

    return counts;
end;;

PrintCounts53A := function(counts)
    Print("[12^3=", counts.t123,
          ", 12^2*14=", counts.t1214,
          ", 12*14^2=", counts.t121414,
          ", 14^3=", counts.t143,
          "]");
end;;

############################################################
# Add coordinate restrictions to fixed-space equations
#
# To force c_i=0 for disallowed coordinates, append column e_i
# to the equation matrix big, because c * e_i = c_i.
############################################################

RestrictedInvariantDim53A := function(inv, allowed)
    local n, allowedSet, aug, i, row, q;

    n := Length(inv.big);

    allowedSet := List([1..n], i -> false);

    for q in allowed do
        allowedSet[q] := true;
    od;

    aug := [];

    for i in [1..n] do
        row := ShallowCopy(inv.big[i]);

        for q in [1..n] do
            if not allowedSet[q] then
                if i = q then
                    Add(row, one45E);
                else
                    Add(row, zero45E);
                fi;
            fi;
        od;

        Add(aug, row);
    od;

    return Length(NullspaceMat(aug));
end;;

