TraceMat42H := function(A)
    local s, i;

    s := zero7_42H;

    for i in [1..Length(A)] do
        s := s + A[i][i];
    od;

    return s;
end;;

TraceLabel42H := function(x)
    if x = 0 * one7_42H then
        return "0";
    elif x = 1 * one7_42H then
        return "1";
    elif x = -1 * one7_42H then
        return "-1";
    elif x = 2 * one7_42H then
        return "2";
    elif x = -2 * one7_42H then
        return "-2";
    elif x = -4 * one7_42H then
        return "-4";
    elif x = 3 * one7_42H then
        return "3";
    elif x = 4 * one7_42H then
        return "4";
    elif x = 5 * one7_42H then
        return "5";
    elif x = 6 * one7_42H then
        return "6";
    else
        return String(x);
    fi;
end;;

TraceLabel26_42H := function(x)
    if x = 0 * one7_42H then
        return "0";
    elif x = 1 * one7_42H then
        return "1";
    elif x = -1 * one7_42H then
        return "-1";
    elif x = 2 * one7_42H then
        return "2";
    elif x = -2 * one7_42H then
        return "-2";
    elif x = -4 * one7_42H then
        return "-4";
    else
        return String(x);
    fi;
end;;

TraceLabel52_42H := function(x)
    if x = 0 * one7_42H then
        return "0";
    elif x = 2 * one7_42H then
        return "2";
    elif x = -2 * one7_42H then
        return "-2";
    elif x = -4 * one7_42H then
        return "-4";
    else
        return String(x);
    fi;
end;;

ActionExponentCyclic42H := function(g, x)
    local gx, k, n;

    n := Order(g);
    gx := g^x;

    for k in [0..n-1] do
        if gx = g^k then
            return k;
        fi;
    od;

    return fail;
end;;

FindBruhatWitness42H := function(g, f, t)
    local i, j, b, bt, id;

    id := t^0;

    for i in [0..12] do
        for j in [0..5] do
            b := g^i * f^j;
            bt := b * t;

            if bt <> id and bt^3 = id then
                return rec(i := i, j := j, order := Order(bt));
            fi;
        od;
    od;

    return fail;
end;;

NormalFormsCount42H := function(g, f)
    local L, i, j;

    L := [];

    for i in [0..12] do
        for j in [0..5] do
            Add(L, g^i * f^j);
        od;
    od;

    return Length(Set(L));
end;;

BlockDiag2_42H := function(A, B)
    local n, m, C, i, j;

    n := Length(A);
    m := Length(B);

    C := NullMat(n + m, n + m, F7_42H);

    for i in [1..n] do
        for j in [1..n] do
            C[i][j] := A[i][j];
        od;
    od;

    for i in [1..m] do
        for j in [1..m] do
            C[n+i][n+j] := B[i][j];
        od;
    od;

    return C;
end;;

TopLeftBlock42H := function(A, d)
    local C, i, j;

    C := NullMat(d, d, F7_42H);

    for i in [1..d] do
        for j in [1..d] do
            C[i][j] := A[i][j];
        od;
    od;

    return C;
end;;

BottomRightBlock42H := function(A, d)
    local n, m, C, i, j;

    n := Length(A);
    m := n - d;

    C := NullMat(m, m, F7_42H);

    for i in [1..m] do
        for j in [1..m] do
            C[i][j] := A[d+i][d+j];
        od;
    od;

    return C;
end;;

IsTarget26Trace42H := function(g, f, t)
    if TraceMat42H(g) <> 0 * one7_42H then
        return false;
    fi;

    if TraceMat42H(f) <> 1 * one7_42H then
        return false;
    fi;

    if TraceMat42H(f^2) <> -1 * one7_42H then
        return false;
    fi;

    if TraceMat42H(f^3) <> -2 * one7_42H then
        return false;
    fi;

    if TraceMat42H(t) <> -2 * one7_42H then
        return false;
    fi;

    return true;
end;;

PrintTraceProfile26_42H := function(g, f, t)
    Print("  Trace(g)   = ", TraceLabel26_42H(TraceMat42H(g)), "\n");
    Print("  Trace(f)   = ", TraceLabel26_42H(TraceMat42H(f)), "\n");
