LinearComboVectors56B := function(coeffs, basis)
    local out, i, k;

    out := List([1..Length(basis[1])], k -> zero45E);

    for i in [1..Length(coeffs)] do
        if coeffs[i] <> zero45E then
            for k in [1..Length(out)] do
                out[k] := out[k] + coeffs[i] * basis[i][k];
            od;
        fi;
    od;

    return out;
end;;

RandomProjectiveCoeff56B := function(dim)
    local F, elts, coeffs, i, first, inv;

    F := GF(7);
    elts := Elements(F);

    coeffs := List([1..dim], i -> Random(elts));

    while ForAll(coeffs, x -> x = zero45E) do
        coeffs := List([1..dim], i -> Random(elts));
    od;

    first := 0;

    for i in [1..dim] do
        if coeffs[i] <> zero45E and first = 0 then
            first := i;
        fi;
    od;

    inv := coeffs[first]^-1;

    for i in [1..dim] do
        coeffs[i] := coeffs[i] * inv;
    od;

    return coeffs;
end;;

ProjectiveCoeffList56B := function(dim, maxRandom)
    local coeffsList, i, c;

    coeffsList := [];

    if dim = 0 then
        return [];
    fi;

    if dim = 1 then
        return [[one45E]];
    fi;

    if dim <= 3 then
        return AllProjectiveCoeffs52A(dim);
    fi;

    # Always include basis directions.
    for i in [1..dim] do
        c := List([1..dim], j -> zero45E);
        c[i] := one45E;
        Add(coeffsList, c);
    od;

    # Add random projective points.
    while Length(coeffsList) < dim + maxRandom do
        c := RandomProjectiveCoeff56B(dim);

        if not c in coeffsList then
            Add(coeffsList, c);
        fi;
    od;

    return coeffsList;
end;;

HomVecToMapRows56B := function(vec, sourceDim, targetDim)
    local rows, i, j, row, pos;

    rows := [];
    pos := 1;

    for i in [1..sourceDim] do
        row := [];

        for j in [1..targetDim] do
            Add(row, vec[pos]);
            pos := pos + 1;
        od;

        Add(rows, row);
    od;

    return rows;
end;;

HomVecToImageBasis56B := function(vec, sourceDim, targetDim)
    return BaseMat(HomVecToMapRows56B(vec, sourceDim, targetDim));
end;;

TraceOfEndVector56B := function(v)
    local M;

    M := VecToMat56A(v, d56B);
    return TraceMat(M);
end;;

SubspaceTraceSummary56B := function(basis)
    local traces, v;

    traces := [];

    for v in basis do
        Add(traces, TraceOfEndVector56B(v));
    od;

    return rec(
        allZero := ForAll(traces, x -> x = zero45E),
        traces := traces
    );
end;;

