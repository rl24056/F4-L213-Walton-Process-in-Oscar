LoadPackage("ctbllib");

F57 := GF(7);;
one57 := One(F57);;
zero57 := Zero(F57);;

SignedGF7_57 := function(x)
    local n;

    for n in [-6..6] do
        if x = n * one57 then
            return n;
        fi;
    od;

    return x;
end;;

SignedListGF7_57 := function(L)
    return List(L, x -> SignedGF7_57(x));
end;;

TraceMat57 := function(A)
    return TraceMat(A);
end;;

Print("Field = GF(7)\n");

############################################################
# PART 1. Build abstract H = PSL(2,13)
############################################################

Print("\n------------------------------------------------------------\n");
Print("PART 1: BUILD ABSTRACT PSL(2,13) WALTON TRIPLE\n");
Print("------------------------------------------------------------\n");

H57 := PSL(2,13);;

Print("|H| = ", Size(H57), "\n");

ActionExponent57 := function(g, x)
    local gx, k;

    gx := g^x;

    for k in [0..12] do
        if gx = g^k then
            return k;
        fi;
    od;

    return fail;
end;;

g57 := First(Elements(H57), x -> Order(x) = 13);;
P57 := Group(g57);;
N57 := Normalizer(H57, P57);;

Print("Order(g) = ", Order(g57), "\n");
Print("|<g>| = ", Size(P57), "\n");
Print("|N_H(<g>)| = ", Size(N57), "\n");

f57 := fail;;

for x57 in Elements(N57) do
    if Order(x57) = 6 then
        if ActionExponent57(g57, x57) = 10 then
            f57 := x57;
            break;
        fi;
    fi;
od;

if f57 = fail then
    Error("Could not find f of order 6 acting on <g> by exponent 10.");
fi;

B57 := Group(g57, f57);;

Print("Order(f) = ", Order(f57), "\n");
Print("Action exponent of f on <g> = ", ActionExponent57(g57, f57), "\n");
Print("|B=<g,f>| = ", Size(B57), "\n");

t57 := fail;;

for x57 in Elements(H57) do
    if Order(x57) = 2 then
        if not x57 in B57 then
            if f57^x57 = f57^-1 then
                if ActionExponent57(g57, x57) = fail then
                    if Order(g57 * x57) = 3 then
                        if Size(Group(g57, f57, x57)) = Size(H57) then
                            t57 := x57;
                            break;
                        fi;
                    fi;
                fi;
            fi;
        fi;
    fi;
od;

