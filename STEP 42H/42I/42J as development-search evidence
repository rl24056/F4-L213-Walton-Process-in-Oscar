                  "\n");
        od;

        ############################################################
        # PART 2. Target vectors in the Brauer class order
        ############################################################

        Value12ByOrder43E := function(o)
            if o = 1 then
                return 12;
            elif o = 2 then
                return 0;
            elif o = 3 then
                return 0;
            elif o = 6 then
                return 0;
            elif o = 13 then
                return -1;
            else
                return fail;
            fi;
        end;;

        Value14ByOrder43E := function(o)
            if o = 1 then
                return 14;
            elif o = 2 then
                return -2;
            elif o = 3 then
                return -1;
            elif o = 6 then
                return 1;
            elif o = 13 then
                return 1;
            else
                return fail;
            fi;
        end;;

        vec12_43E := List(orders43E, o -> Value12ByOrder43E(o));;
        vec14_43E := List(orders43E, o -> Value14ByOrder43E(o));;
        vec26_43E := vec12_43E + vec14_43E;;
        vec38_43E := 2 * vec12_43E + vec14_43E;;
        vec52_43E := 2 * vec12_43E + 2 * vec14_43E;;

