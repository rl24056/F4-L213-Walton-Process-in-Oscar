JordanFailuresOnPairs60B := function(prod, pairs)
    local count, pairObj, x, y, x2, yx, left, right;

    count := 0;

    for pairObj in pairs do
        x := pairObj.x;
        y := pairObj.y;

        x2 := ProdVec59(x, x, prod);
        yx := ProdVec59(y, x, prod);

        left := ProdVec59(ProdVec59(x2, y, prod), x, prod);
        right := ProdVec59(x2, yx, prod);

        if left <> right then
            count := count + 1;
        fi;
    od;

    return count;
end;;

