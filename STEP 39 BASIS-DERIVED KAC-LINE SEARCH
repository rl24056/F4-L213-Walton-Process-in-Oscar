        RootGroupMatrix32(pos32[i], one7_32)
        * RootGroupMatrix32(neg32[i], -one7_32)
        * RootGroupMatrix32(pos32[i], one7_32)
    );
od;

Wlift32 := Group(WeylLifts32);;

Print("Size(Wlift32) = ", Size(Wlift32), "\n");

