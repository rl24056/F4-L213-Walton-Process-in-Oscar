        Print("PART 5: MANUAL INTERPRETATION\n");
        Print("============================================================\n");

        Print("The computed V26 from Step 43A/43B/43D has traces:\n");
        Print("  V26 on orders 1,2,3,6,13,13 = ",
              vec26_43E, "\n");

        Print("The computed V52 fingerprint has traces:\n");
        Print("  V52 on orders 1,2,3,6,13,13 = ",
              vec52_43E, "\n");

        Print("\nExpected interpretation:\n");
        Print("  V26 = 12 + 14-record #4.\n");
        Print("  V38 = 12 + 12 + 14-record #4.\n");
        Print("  V52 = 14 + V38 = 2*12 + 2*14-record #4.\n");
        Print("  This is compatible with the supervisor's possible G2 route:\n");
        Print("      L(F4)|G2 = 14 + 38,\n");
        Print("      and 38|L2(13) = 12 + 12 + 14.\n");

        ############################################################
        # PART 6. Cross-check with named class traces from Step 43D
        ############################################################

        Print("\n============================================================\n");
        Print("PART 6: NAMED ELEMENT TRACE CROSS-CHECK\n");
        Print("============================================================\n");

        if IsBound(g26_43A) and IsBound(f26_43A) and IsBound(t26_43A) then

            Print("Named elements from the constructed triple:\n");
            Print("  g   order ", Order(g26_43A),
