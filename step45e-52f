############################################################

SignedGF7_45E := function(x)
    local n;
    for n in [-3..3] do
        if x = n * one45E then
            return n;
        fi;
    od;
    return x;
end;;

TraceMatManual45E := function(A)
    local d, i, s;
    d := Length(A);
    s := zero45E;
    for i in [1..d] do
        s := s + A[i][i];
    od;
    return s;
end;;

SignedTrace45E := function(A)
    return SignedGF7_45E(TraceMatManual45E(A));
end;;

ConjBy45E := function(x, y)
    return y^-1 * x * y;
end;;

ActionExponent45E := function(g, x)
    local gx, k;
    gx := ConjBy45E(g, x);
    for k in [0..12] do
        if gx = g^k then
            return k;
        fi;
    od;
    return fail;
end;;

IsMatrixList45E := function(L)
    if not IsList(L) then
        return false;
    fi;
    if Length(L) = 0 then
        return false;
    fi;
    if not IsList(L[1]) then
        return false;
    fi;
    if Length(L[1]) = 0 then
        return false;
    fi;
    if not IsList(L[1][1]) then
        return false;
    fi;
    return true;
end;;

GetModuleMats45E := function(r)
    local names, name, val;

    if IsMatrixList45E(r) then
        return r;
    fi;

    if not IsRecord(r) then
        return fail;
    fi;

    names := RecNames(r);

    for name in [
        "generators",
        "gens",
        "matrices",
        "images",
        "genimages",
        "generatorsOfModule",
        "generatorImages"
    ] do
        if name in names then
            val := r.(name);
            if IsMatrixList45E(val) then
                return val;
            fi;
        fi;
    od;

    return fail;
end;;

BlockDiag2Mat45E := function(A, B)
    local d1, d2, d, z, C, i, j;

    d1 := Length(A);
    d2 := Length(B);
    d := d1 + d2;
    z := Zero(A[1][1]);

    C := List([1..d], i -> List([1..d], j -> z));

    for i in [1..d1] do
        for j in [1..d1] do
            C[i][j] := A[i][j];
        od;
    od;

    for i in [1..d2] do
        for j in [1..d2] do
            C[d1+i][d1+j] := B[i][j];
        od;
    od;

    return C;
end;;

FirstFive45E := function(L)
    return [L[1], L[2], L[3], L[4], L[5]];
end;;

FindBruhatWitness45E := function(Belts, t)
    local b;

    for b in Belts do
        if b*t <> One(Parent(Belts[1])) and Order(b*t) = 3 then
            return b;
        fi;
    od;

    return fail;
end;;

