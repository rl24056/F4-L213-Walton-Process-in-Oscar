                        if totalTests mod PROGRESS_EVERY61 = 0 then
                            elapsed := Runtime() - startTime;
                            Print("    product ", rep.index,
                                  " support-test progress: ", totalTests,
                                  " | elapsed ms=", elapsed, "\n");

                            if elapsed >= TIME_LIMIT_MS61 then
                                return rec(
                                    status := "time_limit",
                                    totalTests := totalTests,
                                    failures := failures,
                                    firstFailure := firstFailure,
                                    maxSupportCompleted := 1
                                );
                            fi;
                        fi;
                    od;
                od;
            od;
        od;
    fi;

    ########################################################
    # support size 3
    ########################################################

    if maxSupport >= 3 then
        for i in [1..25] do
            for j in [i+1..26] do
                for k in [j+1..27] do
                    supp := [i,j,k];

                    for coeffs in CoeffTuples3_61 do
                        x := VectorFromSupport61(supp, coeffs);

                        for yIndex in [1..27] do
                            y := BasisVec59(27, yIndex);
                            diff := JordanFailureVec61(prod, x, y);
                            totalTests := totalTests + 1;

                            if not IsZeroVec61(diff) then
                                failures := failures + 1;

                                if firstFailure = fail then
                                    firstFailure := rec(
                                        support := supp,
                                        coeffs := coeffs,
                                        yIndex := yIndex,
                                        diff := diff
                                    );
                                fi;

                                return rec(
                                    status := "failure",
                                    totalTests := totalTests,
                                    failures := failures,
                                    firstFailure := firstFailure,
                                    maxSupportCompleted := 2
                                );
                            fi;

                            if totalTests mod PROGRESS_EVERY61 = 0 then
                                elapsed := Runtime() - startTime;
                                Print("    product ", rep.index,
                                      " support-test progress: ", totalTests,
                                      " | elapsed ms=", elapsed, "\n");

                                if elapsed >= TIME_LIMIT_MS61 then
                                    return rec(
                                        status := "time_limit",
                                        totalTests := totalTests,
                                        failures := failures,
                                        firstFailure := firstFailure,
                                        maxSupportCompleted := 2
                                    );
                                fi;
                            fi;
                        od;
                    od;
                od;
            od;
        od;
    fi;

    return rec(
        status := "passed",
