DotLabelKacMod13_32 := function(label, kac)
    local s, i;

    s := 0;

    for i in [1..4] do
        s := s + label[i] * kac[i];
    od;

    return s mod 13;
end;;

BuildGFromDerivedLabels32 := function(kac, sign)
    local diag, i, e, label;

    diag := [];

    for i in [1..48] do
        label := RootLabelsRaw32[i];

        e := DotLabelKacMod13_32(label, kac);

        if sign = -1 then
            e := (-e) mod 13;
        fi;

        Add(diag, zeta13_32^e);
    od;

    for i in [1..4] do
        Add(diag, oneExt32);
    od;

    return DiagMatFromListExt32(diag);
end;;

