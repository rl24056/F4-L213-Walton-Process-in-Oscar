            Print("  g*t order ", Order(g26_43A * t26_43A),
                  " | expected V26 trace -1 | expected V52 trace -2\n");

        else

            Print("Named elements g26_43A, f26_43A, t26_43A not bound.\n");

        fi;

    fi;
fi;

