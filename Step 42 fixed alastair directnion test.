MatrixTSearch42B := function(HM, gM, fM)
    local B, L, t, wit, elts;

    B := Group(gM, fM);
    L := [];
    elts := Elements(HM);

    for t in elts do
        if Order(t) = 2
           and fM^t = fM^-1
           and not (t in B)
           and ActionExponentCyclic42B(gM, t) = fail
           and Size(Group(gM, fM, t)) = Size(HM) then

            wit := FindBruhatWitness42B(gM, fM, t);

            if wit <> fail then
                Add(L, rec(
                    t := t,
                    wit := wit,
                    trace := TraceMat42B(t),
                    gt_order := Order(gM * t)
                ));
            fi;
        fi;
    od;

    return L;
end;;

