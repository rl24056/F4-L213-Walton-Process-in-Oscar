############################################################
# Pair indexing for Lambda^2
############################################################

BuildPairData58 := function(d)
    local pairs, pairIndex, i, j, idx;

    pairs := [];
    pairIndex := [];

    for i in [1..d] do
        pairIndex[i] := [];
    od;

    idx := 0;

    for i in [1..d] do
        for j in [i+1..d] do
            idx := idx + 1;
            Add(pairs, [i,j]);
            pairIndex[i][j] := idx;
            pairIndex[j][i] := idx;
        od;
    od;

    return rec(
        pairs := pairs,
        pairIndex := pairIndex,
        dim := Length(pairs)
    );
end;;

############################################################
# Exterior square matrix for row-vector convention
############################################################

ExteriorSquareMat58 := function(A)
    local d, pdata, pairs, pairIndex, wdim, E,
          p, i, j, r, s, q, coeff;

    d := Length(A);
    pdata := BuildPairData58(d);
    pairs := pdata.pairs;
    pairIndex := pdata.pairIndex;
    wdim := pdata.dim;

    E := NullMat(wdim, wdim, F58);

    for p in [1..wdim] do
        i := pairs[p][1];
        j := pairs[p][2];

        for r in [1..d] do
            if A[i][r] <> zero58 then
                for s in [1..d] do
                    if A[j][s] <> zero58 then
                        coeff := A[i][r] * A[j][s];

                        if r < s then
                            q := pairIndex[r][s];
                            E[p][q] := E[p][q] + coeff;
                        elif r > s then
                            q := pairIndex[s][r];
                            E[p][q] := E[p][q] - coeff;
                        fi;
                    fi;
                od;
            fi;
        od;
    od;

    return E;
end;;

############################################################
# Hom solver:
# For row convention, an H-map X: source -> target satisfies
#
#       S * X = X * T
#
############################################################

HomVecToRows58 := function(vec, sourceDim, targetDim)
    local rows, i, k, pos, row;

    rows := [];
    pos := 1;

    for i in [1..sourceDim] do
        row := [];

        for k in [1..targetDim] do
            Add(row, vec[pos]);
            pos := pos + 1;
        od;

        Add(rows, row);
    od;

    return rows;
end;;

HomVecSatisfies58 := function(vec, sourceMats, targetMats, sourceDim, targetDim)
    local X, a;

    X := HomVecToRows58(vec, sourceDim, targetDim);

    for a in [1..Length(sourceMats)] do
        if sourceMats[a] * X <> X * targetMats[a] then
            return false;
        fi;
    od;

    return true;
end;;

HomBasisRows58 := function(sourceMats, targetMats)
    local sourceDim, targetDim, numVars, varIndex,
          rows, a, S, T, i, k, j, l, row,
          rawBasis, goodBasis, v, rawBasis2;

    sourceDim := Length(sourceMats[1]);
    targetDim := Length(targetMats[1]);
    numVars := sourceDim * targetDim;

    varIndex := function(i, k)
        return (i-1) * targetDim + k;
    end;

    rows := [];

    for a in [1..Length(sourceMats)] do
        S := sourceMats[a];
        T := targetMats[a];

        for i in [1..sourceDim] do
            for k in [1..targetDim] do

                row := List([1..numVars], x -> zero58);

                # coefficient from S*X
                for j in [1..sourceDim] do
                    if S[i][j] <> zero58 then
                        row[varIndex(j,k)] := row[varIndex(j,k)] + S[i][j];
                    fi;
                od;

                # coefficient from -X*T
                for l in [1..targetDim] do
                    if T[l][k] <> zero58 then
                        row[varIndex(i,l)] := row[varIndex(i,l)] - T[l][k];
                    fi;
                od;

                Add(rows, row);
            od;
        od;
    od;

    rawBasis := NullspaceMat(rows);

    goodBasis := [];

    for v in rawBasis do
        if Length(v) = numVars then
            if HomVecSatisfies58(v, sourceMats, targetMats, sourceDim, targetDim) then
                Add(goodBasis, v);
            fi;
        fi;
    od;

    if Length(goodBasis) > 0 then
        return goodBasis;
    fi;

    # Fallback in case this GAP installation uses the opposite nullspace convention.
    rawBasis2 := NullspaceMat(TransposedMat(rows));

    for v in rawBasis2 do
        if Length(v) = numVars then
            if HomVecSatisfies58(v, sourceMats, targetMats, sourceDim, targetDim) then
                Add(goodBasis, v);
            fi;
        fi;
    od;

    return goodBasis;
end;;

############################################################
# Projective coefficient list over GF(7)
############################################################

AllProjectiveCoeffs58 := function(dim)
    local F, elts, coeffs, out, recFun, first, inv, c, i;

    F := GF(7);
    elts := Elements(F);
    out := [];

    recFun := function(pos, current)
        local a, copy;

        if pos > dim then
            if ForAll(current, x -> x = zero58) then
                return;
            fi;

            first := 0;

            for i in [1..dim] do
                if current[i] <> zero58 and first = 0 then
                    first := i;
                fi;
            od;

            inv := current[first]^-1;
            c := List(current, x -> x * inv);

            if not c in out then
                Add(out, c);
            fi;

            return;
        fi;

        for a in elts do
            copy := ShallowCopy(current);
            Add(copy, a);
            recFun(pos+1, copy);
        od;
    end;

    recFun(1, []);

    return out;
end;;

RandomProjectiveCoeffs58 := function(dim, howMany)
    local F, elts, out, c, i, first, inv;

    F := GF(7);
    elts := Elements(F);
    out := [];

    while Length(out) < howMany do
        c := List([1..dim], i -> Random(elts));

        while ForAll(c, x -> x = zero58) do
            c := List([1..dim], i -> Random(elts));
        od;

        first := 0;

        for i in [1..dim] do
            if c[i] <> zero58 and first = 0 then
                first := i;
            fi;
        od;

        inv := c[first]^-1;
        c := List(c, x -> x * inv);

        if not c in out then
            Add(out, c);
        fi;
    od;

    return out;
end;;

CoeffList58 := function(dim)
    if dim = 0 then
        return [];
    fi;

    if dim <= 4 then
        return AllProjectiveCoeffs58(dim);
    fi;

    return RandomProjectiveCoeffs58(dim, 1000);
end;;

LinearCombo58 := function(coeffs, basis)
    local out, i, k;

    out := List([1..Length(basis[1])], k -> zero58);

    for i in [1..Length(coeffs)] do
        if coeffs[i] <> zero58 then
            for k in [1..Length(out)] do
                out[k] := out[k] + coeffs[i] * basis[i][k];
            od;
        fi;
    od;

    return out;
end;;

############################################################
# Jacobi test for bracket Lambda^2(V) -> V
############################################################

BracketBasis58 := function(i, j, br, pdata, d)
    local z, q;

    z := List([1..d], k -> zero58);

    if i = j then
        return z;
    fi;

    if i < j then
        q := pdata.pairIndex[i][j];
        return br[q];
    else
        q := pdata.pairIndex[j][i];
        return List(br[q], x -> -x);
    fi;
end;;

BracketBasisWithVec58 := function(i, v, br, pdata, d)
    local out, l, b, k;

    out := List([1..d], k -> zero58);

    for l in [1..d] do
        if v[l] <> zero58 then
            b := BracketBasis58(i, l, br, pdata, d);

            for k in [1..d] do
                out[k] := out[k] + v[l] * b[k];
            od;
        fi;
    od;

    return out;
end;;

JacobiFailures58 := function(br, d)
    local pdata, failCount, i, j, k, a, b, c, term1, term2, term3, total, r;

    pdata := BuildPairData58(d);
    failCount := 0;

    for i in [1..d] do
        for j in [i+1..d] do
            for k in [j+1..d] do

                a := BracketBasis58(j, k, br, pdata, d);
                b := BracketBasis58(k, i, br, pdata, d);
                c := BracketBasis58(i, j, br, pdata, d);

                term1 := BracketBasisWithVec58(i, a, br, pdata, d);
                term2 := BracketBasisWithVec58(j, b, br, pdata, d);
                term3 := BracketBasisWithVec58(k, c, br, pdata, d);

                total := [];

                for r in [1..d] do
                    Add(total, term1[r] + term2[r] + term3[r]);
                od;

                if not ForAll(total, x -> x = zero58) then
                    failCount := failCount + 1;
                fi;
            od;
        od;
    od;

    return failCount;
end;;

BracketRank58 := function(br)
    return Length(BaseMat(br));
end;;

