epi57 := EpimorphismFromFreeGroup(Hsrc57);;
free57 := Source(epi57);;
freeGens57 := GeneratorsOfGroup(free57);;

pre_g57 := PreImagesRepresentative(epi57, g57);;
pre_f57 := PreImagesRepresentative(epi57, f57);;
pre_t57 := PreImagesRepresentative(epi57, t57);;
pre_gt57 := PreImagesRepresentative(epi57, g57 * t57);;

ModuleMatrices57 := function(M)
    if IsRecord(M) then
        if IsBound(M.generators) then
            return M.generators;
        fi;

        if IsBound(M.gens) then
            return M.gens;
        fi;

        if IsBound(M.matrices) then
            return M.matrices;
        fi;

        Print("Record names available: ", RecNames(M), "\n");
        Error("Do not know where generator matrices are stored in this module record.");
    fi;

    return M;
end;;

ImageByPreword57 := function(M, pre)
    local mats, MG, phi;

    mats := ModuleMatrices57(M);

    if Length(mats) <> Length(freeGens57) then
        Print("Length(mats) = ", Length(mats), "\n");
        Print("Length(freeGens57) = ", Length(freeGens57), "\n");
        Error("Module generator count does not match free generator count.");
    fi;

    MG := Group(mats);
    phi := GroupHomomorphismByImages(
        free57,
        MG,
        freeGens57,
        mats
    );

    return Image(phi, pre);
end;;

ModuleDim57 := function(M)
    local mats;

    mats := ModuleMatrices57(M);
    return Length(mats[1]);
end;;

ModuleProfile57 := function(M)
    local gm, fm, tm, vals;

    gm := ImageByPreword57(M, pre_g57);
    fm := ImageByPreword57(M, pre_f57);
    tm := ImageByPreword57(M, pre_t57);

    vals := [
        TraceMat57(gm),
        TraceMat57(fm),
        TraceMat57(fm^2),
        TraceMat57(fm^3),
        TraceMat57(tm),
        TraceMat57(gm * tm)
    ];

    return vals;
end;;

