oneExt32 := One(Fext32);;

trace_f_target_32  := 2 * one7_32;;
trace_f2_target_32 := 5 * one7_32;;
trace_t_target_32  := 3 * one7_32;;

zeta13_32 := Z(7,12)^((7^12 - 1) / 13);;

Print("Order(zeta13_32) = ", Order(zeta13_32), "\n");

############################################################
# PART 1. Build L(F4) over GF(7)
############################################################

Print("\n============================================================\n");
Print("PART 1: BUILD L(F4)\n");
Print("============================================================\n");

L32 := SimpleLieAlgebra("F", 4, F7_32);;
CB32 := ChevalleyBasis(L32);;

pos32 := CB32[1];;
neg32 := CB32[2];;
cart32 := CB32[3];;

basisList32 := Concatenation(pos32, neg32, cart32);;
Basis32 := Basis(L32, basisList32);;

Print("Dimension L32 = ", Dimension(L32), "\n");
Print("Positive roots = ", Length(pos32), "\n");
Print("Negative roots = ", Length(neg32), "\n");
Print("Cartan dim     = ", Length(cart32), "\n");

One52_32 := IdentityMat(52, F7_32);;
Zero52_32 := NullMat(52, 52, F7_32);;
One52Ext32 := IdentityMat(52, Fext32);;

############################################################
# PART 2. Helpers
############################################################

Trace32 := function(M)
    local s, i;

    s := Zero(M[1][1]);

    for i in [1..Length(M)] do
        s := s + M[i][i];
    od;

    return s;
end;;

TraceIsZero32 := function(M)
    return Trace32(M) = Zero(Trace32(M));
end;;

GoodTraceProfileF32 := function(x)
    return Order(x) = 6
       and Trace32(x) = trace_f_target_32
       and Trace32(x^2) = trace_f2_target_32
       and Trace32(x^3) = trace_t_target_32;
end;;

LiftMatToExt32 := function(M)
    local n, m, N, i, j;

    n := Length(M);
    m := Length(M[1]);

    N := NullMat(n, m, Fext32);

    for i in [1..n] do
        for j in [1..m] do
            N[i][j] := IntFFE(M[i][j]) * oneExt32;
        od;
    od;

    return N;
end;;

MatrixInList32 := function(x, L)
    local y;

    for y in L do
        if x = y then
            return true;
        fi;
    od;

    return false;
end;;

DistinctMatrixList32 := function(L)
    local D, x;

    D := [];

    for x in L do
        if not MatrixInList32(x, D) then
            Add(D, x);
        fi;
    od;

    return D;
end;;

ActionExponentOnGExt32 := function(g, x)
    local gx, k;

    gx := g^x;

    for k in [0..12] do
        if gx = g^k then
            return k;
        fi;
    od;

    return fail;
end;;

############################################################
# PART 3. Root group matrices
############################################################

Print("\n============================================================\n");
Print("PART 3: BUILD ROOT GROUP MATRICES\n");
Print("============================================================\n");

RootGroupMatrix32 := function(v, t)
    local A, M, term, coeff, k;

    A := AdjointMatrix(Basis32, v);

    M := IdentityMat(52, F7_32);

    term := A;
    coeff := t;

    M := M + coeff * term;

    for k in [2..6] do
        term := term * A;
        coeff := coeff * t / (k * one7_32);

        if term = Zero52_32 then
            break;
        fi;

        M := M + coeff * term;
    od;

    return M;
end;;

rootMats32 := [];;

for i in [1..Length(pos32)] do
    Add(rootMats32, RootGroupMatrix32(pos32[i], one7_32));
od;

for i in [1..Length(neg32)] do
    Add(rootMats32, RootGroupMatrix32(neg32[i], one7_32));
od;

Print("Number of root group generators = ", Length(rootMats32), "\n");

G32B := Group(rootMats32);;

