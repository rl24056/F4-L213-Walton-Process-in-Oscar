                od;
            od;
        od;
    fi;

    ########################################################
    # support size 2
    ########################################################

    if maxSupport >= 2 then
        for i in [1..26] do
            for j in [i+1..27] do
                supp := [i,j];

                for coeffs in CoeffTuples2_61 do
                    x := VectorFromSupport61(supp, coeffs);

                    for yIndex in [1..27] do
                        y := BasisVec59(27, yIndex);
                        diff := JordanFailureVec61(prod, x, y);
                        totalTests := totalTests + 1;

                        if not IsZeroVec61(diff) then
                            failures := failures + 1;

                            if firstFailure = fail then
                                firstFailure := rec(
                                    support := supp,
                                    coeffs := coeffs,
                                    yIndex := yIndex,
