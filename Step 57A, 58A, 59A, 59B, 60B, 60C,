            elif i >= 2 and i <= 13 and j >= 14 and j <= 27 then
                a := i - 1;
                b := j - 13;
                q := (a-1)*14 + b;

                out := ZeroVec59(27);
                out := AddVec59(out, EmbedToV27_59(mT_12[q], "12"));
                out := AddVec59(out, EmbedToV27_59(mT_14[q], "14"));

