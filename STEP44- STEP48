QuietJacobi45D := function(M, d, F, pairIndex)
    local z, one, zeroVec, unitVec, bracketVec, vecAdd, isZeroVec;
    local i, j, k, ei, ej, ek, term1, term2, term3, total, failCount;

    z := Zero(F);
    one := One(F);

    zeroVec := function()
        return List([1..d], x -> z);
    end;

    unitVec := function(pos)
        local v;
        v := zeroVec();
        v[pos] := one;
        return v;
    end;

    bracketVec := function(x, y)
        local out, a, b, p, coeff, c;

        out := zeroVec();

        for a in [1..d] do
            for b in [a+1..d] do
                coeff := x[a]*y[b] - x[b]*y[a];

                if coeff <> z then
                    p := pairIndex[a][b];

                    for c in [1..d] do
                        out[c] := out[c] + coeff * M[p][c];
                    od;
                fi;
            od;
        od;

        return out;
    end;

    vecAdd := function(u, v)
        return List([1..Length(u)], x -> u[x] + v[x]);
    end;

    isZeroVec := function(v)
        local x;
        for x in v do
            if x <> z then
                return false;
            fi;
        od;
        return true;
    end;

    failCount := 0;

    for i in [1..d] do
        for j in [i+1..d] do
            for k in [j+1..d] do
                ei := unitVec(i);
                ej := unitVec(j);
                ek := unitVec(k);

                term1 := bracketVec(ei, bracketVec(ej, ek));
                term2 := bracketVec(ej, bracketVec(ek, ei));
                term3 := bracketVec(ek, bracketVec(ei, ej));

                total := vecAdd(vecAdd(term1, term2), term3);

                if not isZeroVec(total) then
                    failCount := failCount + 1;
                fi;
            od;
        od;
    od;

    return failCount;
end;;

