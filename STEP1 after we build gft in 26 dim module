RankRows62G := function(rows)
    if Length(rows) = 0 then
        return 0;
    fi;
    return RankMat(rows);
end;;

ExtendLowerToUpper62G := function(L, U)
    local B, Q, r, oldrank, newrank;

    B := ShallowCopy(L);
    Q := [];

    for r in U do
        oldrank := RankRows62G(B);
        Add(B, r);
        newrank := RankRows62G(B);

        if newrank > oldrank then
            Add(Q, r);
        else
            Remove(B, Length(B));
        fi;
    od;

    return rec(full := B, quotient := Q);
end;;

InducedQuotientAction62G := function(fullbasis, lowerdim, Gen)
    local n, q, Act, i, v, coeffs, row, j;

    n := Length(fullbasis);
    q := n - lowerdim;
    Act := [];

    for i in [lowerdim + 1 .. n] do
        v := fullbasis[i] * Gen;
        coeffs := SolutionMat(fullbasis, v);

        if coeffs = fail then
            Error("SolutionMat failed in quotient action.");
        fi;

        row := [];

        for j in [lowerdim + 1 .. n] do
            Add(row, coeffs[j]);
        od;

        Add(Act, row);
    od;

    return Act;
end;;

# Signed integer target:
