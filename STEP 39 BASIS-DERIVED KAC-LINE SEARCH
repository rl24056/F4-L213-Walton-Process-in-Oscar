RootGroupMatrix32 := function(v, t)
    local A, M, term, coeff, k;

    A := AdjointMatrix(Basis32, v);

    M := IdentityMat(52, F7_32);

    term := A;
    coeff := t;

    M := M + coeff * term;

    for k in [2..6] do
        term := term * A;
        coeff := coeff * t / (k * one7_32);

        if term = Zero52_32 then
            break;
        fi;

        M := M + coeff * term;
    od;

    return M;
