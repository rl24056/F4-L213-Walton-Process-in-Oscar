ActionExponent62 := function(g, x)
    local k;
    for k in [0..12] do
        if g^x = g^k then
            return k;
        fi;
    od;
    return fail;
end;;

g62 := First(Elements(H62), x -> Order(x) = 13);;
P62 := Group(g62);;
N62 := Normalizer(H62, P62);;

Print("Order(g62) = ", Order(g62), "\n");
Print("|N_H(<g>)| = ", Size(N62), "\n");

FCands62 := Filtered(Elements(N62),
    x -> Order(x) = 6 and ActionExponent62(g62, x) = 10);;

Print("Number of f-candidates acting by exponent 10 = ",
      Length(FCands62), "\n");

if Length(FCands62) = 0 then
    Error("No f-candidate found.");
fi;

