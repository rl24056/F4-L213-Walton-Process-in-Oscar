    for lineNo in [1..Length(KacLines32_local)] do

        kac := KacLines32_local[lineNo];

        Print("\n------------------------------------------------------------\n");
        Print("Testing Kac line #", lineNo, ": ", kac, "\n");
        Print("------------------------------------------------------------\n");

        g := BuildGoodGExtFromKacLine32(kac);

        Print("g^13 = 1? ", g^13 = One52Ext32, "\n");
        Print("g <> 1? ", g <> One52Ext32, "\n");
        Print("Trace(g)=0? ", TraceIsZero32(g), "\n");

        actionF := ActionExponentOnGExt32(g, fExt32);

        Print("Action exponent of f on <g> = ", actionF, "\n");
        Print("g^f = g^10? ", g^fExt32 = g^10, "\n");
        Print("g^f = g^4 ? ", g^fExt32 = g^4, "\n");

        if TraceIsZero32(g) and actionF = 10 then

            BRecords := BuildBExtNormalForms32(g, fExt32);
            BMats := List(BRecords, r -> r.elt);
            distinctBCount := Length(DistinctMatrixList32(BMats));

            Print("Distinct normal forms g^i f^j = ", distinctBCount, "\n");

            basicGoodIndices := [];
            hitRecords := [];

            if distinctBCount = 78 then

                for idx in [1..Length(TraceMinus4ExactInvertersExt32)] do

                    t := TraceMinus4ExactInvertersExt32[idx];

                    actionT := ActionExponentOnGExt32(g, t);

                    if actionT = fail then

                        if not MatrixInList32(t, BMats) then

                            Add(basicGoodIndices, idx);

                            witnesses := BruhatWitnesses32(g, fExt32, t);

                            if Length(witnesses) > 0 then

                                Add(
                                    hitRecords,
                                    rec(
                                        t_index := idx,
                                        first_witness := witnesses[1],
                                        all_witnesses := witnesses
                                    )
                                );

                                Print("BRUHAT HIT FOUND!\n");
                                Print("  line = ", lineNo, "\n");
                                Print("  t index = ", idx, "\n");
                                Print("  witness [i,j] = ", witnesses[1], "\n");

                            fi;

                        fi;

                    fi;

                od;

            fi;

            Print("Basic external candidates = ", Length(basicGoodIndices), "\n");
            Print("Bruhat hits = ", Length(hitRecords), "\n");

            Add(
                AllLineResults32_local,
                rec(
                    line_number := lineNo,
                    kac_line := kac,
                    action_of_f := actionF,
                    distinct_B_normal_forms := distinctBCount,
                    basic_external_candidate_indices := basicGoodIndices,
                    bruhat_hits := hitRecords
                )
            );

        else
            Print("SKIP this line: trace/action condition failed.\n");
        fi;

    od;

    Print("\n============================================================\n");
    Print("FINAL REPORT STEP 38B\n");
    Print("============================================================\n");

    for lineNo in [1..Length(AllLineResults32_local)] do
        r := AllLineResults32_local[lineNo];

        Print("\nLine #", r.line_number, ": ", r.kac_line, "\n");
        Print("  action of f = ", r.action_of_f, "\n");
        Print("  distinct B normal forms = ", r.distinct_B_normal_forms, "\n");
        Print("  basic external candidates = ",
              Length(r.basic_external_candidate_indices), "\n");
        Print("  Bruhat hits = ", Length(r.bruhat_hits), "\n");

        if Length(r.bruhat_hits) > 0 then
            Print("  first hit t index = ", r.bruhat_hits[1].t_index, "\n");
            Print("  first witness = ", r.bruhat_hits[1].first_witness, "\n");
        fi;
    od;

    KacLines32 := KacLines32_local;
    AllLineResults32 := AllLineResults32_local;

    return AllLineResults32_local;
end;;

