        for bidx in [1..n] do
            mon := data.basis[bidx];
            a := mon[1];
            b := mon[2];

            row := List([1..n], i -> zero45E);

            for rr in supps[a] do
                for ss in supps[b] do
                    coeff := rr[2] * ss[2];

                    if rr[1] <= ss[1] then
                        q := data.index2[rr[1]][ss[1]];
                    else
                        q := data.index2[ss[1]][rr[1]];
                    fi;

                    row[q] := row[q] + coeff;
                od;
            od;

            Add(rows, row);
        od;

    elif deg = 3 then

        for bidx in [1..n] do
            mon := data.basis[bidx];
            a := mon[1];
            b := mon[2];
            c := mon[3];

            row := List([1..n], i -> zero45E);

            for rr in supps[a] do
                for ss in supps[b] do
                    for tt in supps[c] do
                        coeff := rr[2] * ss[2] * tt[2];

                        tup := [rr[1], ss[1], tt[1]];
                        Sort(tup);

                        q := data.index3[tup[1]][tup[2]][tup[3]];
                        row[q] := row[q] + coeff;
                    od;
                od;
            od;

            Add(rows, row);

            if bidx mod 500 = 0 then
                Print("      built Sym^3 row ", bidx, " / ", n, "\n");
            fi;
        od;

    else
        Error("Only symmetric degrees 2 and 3 are implemented.");
    fi;

    return rows;
end;;

