ActionExponentCyclic42B := function(g, x)
    local gx, k, n;

    n := Order(g);
    gx := g^x;

    for k in [0..n-1] do
        if gx = g^k then
            return k;
        fi;
    od;

    return fail;
end;;

FindBruhatWitness42B := function(g, f, t)
    local i, j, b, bt;

    for i in [0..12] do
        for j in [0..5] do
            b := g^i * f^j;
            bt := b * t;

            if bt <> bt^0 and bt^3 = bt^0 then
                return rec(i := i, j := j, order := Order(bt));
            fi;
        od;
    od;

    return fail;
end;;

NormalFormsCount42B := function(g, f)
    local L, i, j;

    L := [];

    for i in [0..12] do
        for j in [0..5] do
            Add(L, g^i * f^j);
        od;
    od;

    return Length(Set(L));
end;;

BlockDiag2_42B := function(A, B)
    local n, m, C, i, j;

    n := Length(A);
    m := Length(B);

    C := NullMat(n + m, n + m, F7_42B);

    for i in [1..n] do
        for j in [1..n] do
            C[i][j] := A[i][j];
        od;
    od;

    for i in [1..m] do
        for j in [1..m] do
            C[n+i][n+j] := B[i][j];
        od;
    od;

    return C;
end;;

IsBlockDiagonalAt42B := function(A, d)
    local n, i, j, z;

    n := Length(A);
    z := 0 * A[1][1];

    for i in [1..d] do
        for j in [d+1..n] do
            if A[i][j] <> z then
                return false;
            fi;
        od;
    od;

    for i in [d+1..n] do
        for j in [1..d] do
            if A[i][j] <> z then
                return false;
            fi;
        od;
    od;

    return true;
end;;

