                row := List([1..nVars], x -> z);

                for r in [1..d] do
                    if A[i][r] <> z then
                        for s in [1..d] do
                            if A[j][s] <> z then
                                coeff := A[i][r] * A[j][s];

                                if r < s then
                                    q := pairIndex[r][s];
                                    row[VarIndex(q,k)] :=
                                        row[VarIndex(q,k)] + coeff;
                                elif r > s then
                                    q := pairIndex[s][r];
                                    row[VarIndex(q,k)] :=
                                        row[VarIndex(q,k)] - coeff;
                                fi;
                            fi;
                        od;
                    fi;
                od;

                for l in [1..d] do
                    if A[l][k] <> z then
                        row[VarIndex(p,l)] :=
                            row[VarIndex(p,l)] - A[l][k];
                    fi;
                od;

                Add(rows, row);
            od;
        od;
    od;

    null := NullspaceMat(TransposedMat(rows));

    maps := List(null, v -> List([1..nPairs],
        pp -> v{[(pp-1)*d+1 .. pp*d]}));

    ranks := List(maps, X -> RankMat(X));

    elts := Elements(F);
    coeffList := [];

    if Length(maps) = 0 then
        return rec(
            index := rec14.index,
            traces := [rec14.tr_g, rec14.tr_f, rec14.tr_f2,
                       rec14.tr_f3, rec14.tr_t, rec14.tr_gt],
            homDim := 0,
            ranks := [],
            tested := 0,
            good := []
        );
    fi;

    if Length(maps) = 1 then
        coeffList := [[one]];
    elif Length(maps) = 2 then
        for b in elts do
            Add(coeffList, [one,b]);
        od;
        Add(coeffList, [z,one]);
    else
        Print("  Hom dimension is ", Length(maps),
              "; testing basis maps only.\n");

        for ii in [1..Length(maps)] do
            coeffs := List([1..Length(maps)], x -> z);
            coeffs[ii] := one;
            Add(coeffList, coeffs);
        od;
    fi;

    good := [];

    for idx in [1..Length(coeffList)] do
        coeffs := coeffList[idx];

        M := [];

        for p in [1..nPairs] do
            Add(M, []);

            for k in [1..d] do
                c := z;

                for ii in [1..Length(coeffs)] do
                    c := c + coeffs[ii] * maps[ii][p][k];
                od;

                Add(M[p], c);
            od;
        od;

        rank := RankMat(M);
        fails := QuietJacobi45D(M, d, F, pairIndex);

        if rank = 14 and fails = 0 then
            Add(good, rec(coeffs := coeffs, rank := rank, fails := fails));
        fi;
    od;

    return rec(
        index := rec14.index,
        traces := [rec14.tr_g, rec14.tr_f, rec14.tr_f2,
                   rec14.tr_f3, rec14.tr_t, rec14.tr_gt],
        homDim := Length(null),
        ranks := ranks,
        tested := Length(coeffList),
        good := good
    );
end;;

