F62E := GF(7);;
D62E := 26;;
EndDim62E := D62E * D62E;;

Print("V26 dimension = ", D62E, "\n");
Print("End(V26) dimension = ", EndDim62E, "\n");

SignedGF7_62E := function(x)
    local n;
    for n in [-3..3] do
        if x = n * One(F62E) then
            return n;
        fi;
    od;
    return x;
end;;

TraceMat62E := function(A)
    local s, i, d;
    d := Length(A);
    s := Zero(F62E);

    for i in [1..d] do
        s := s + A[i][i];
    od;

    return s;
end;;

TraceSigned62E := function(A)
    return SignedGF7_62E(TraceMat62E(A));
end;;

EndActionMatrix62E := function(A)
    local Ainv, rows, i, j, p, q, row;

    Ainv := A^-1;
    rows := [];

    for i in [1..D62E] do
        for j in [1..D62E] do

            row := [];

            for p in [1..D62E] do
                for q in [1..D62E] do
                    Add(row, Ainv[p][i] * A[j][q]);
                od;
            od;

            Add(rows, row);

        od;
    od;

    return rows;
end;;

