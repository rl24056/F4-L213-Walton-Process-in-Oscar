    return Length(Set(L));
end;;

BlockDiag2_42I := function(A, B)
    local n, m, C, i, j;

    n := Length(A);
    m := Length(B);

    C := NullMat(n + m, n + m, F7_42I);

    for i in [1..n] do
        for j in [1..n] do
            C[i][j] := A[i][j];
        od;
    od;

    for i in [1..m] do
        for j in [1..m] do
            C[n+i][n+j] := B[i][j];
        od;
    od;

    return C;
end;;

TopLeftBlock42I := function(A, d)
    local C, i, j;

    C := NullMat(d, d, F7_42I);

    for i in [1..d] do
