            return rec(coeffs := coeffs, S := S, inv := inv);
        fi;
    od;

    return fail;
end;;

############################################################
# Identify pure and mixed cubic basis vectors
############################################################

FindPureAndMixedCubics54A := function(inv)
    local pure, mixed, i, counts;

    pure := fail;
    mixed := fail;

    for i in [1..Length(inv.basis)] do
        counts := SupportCountsByType53A(inv.basis[i], inv.data);

        if counts.t123 > 0
           and counts.t1214 = 0
           and counts.t121414 = 0
           and counts.t143 = 0 then
            pure := inv.basis[i];
        fi;

        if counts.t123 = 0
           and counts.t1214 = 0
           and counts.t121414 > 0
           and counts.t143 = 0 then
            mixed := inv.basis[i];
        fi;
    od;

    return rec(pure := pure, mixed := mixed);
end;;

ProjectiveCubicCombos54A := function(pure, mixed)
    local F, elts, combos, b;

    F := GF(7);
    elts := Elements(F);
    combos := [];

    Add(combos, rec(label := "mixed only", coeffs := [zero45E, one45E], vec := mixed));
    Add(combos, rec(label := "pure only", coeffs := [one45E, zero45E], vec := pure));

