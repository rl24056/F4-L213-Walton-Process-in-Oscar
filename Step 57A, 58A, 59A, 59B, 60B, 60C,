############################################################

RandomCoeffsAllowZero59 := function(dim)
    local elts;

    elts := Elements(F59);

    if dim = 0 then
        return [];
    fi;

    return List([1..dim], i -> Random(elts));
end;;

LinearComboHomVec59 := function(coeffs, homBasis, sourceDim, targetDim)
    local out, i, k;

    if Length(homBasis) = 0 then
        return List([1..sourceDim*targetDim], k -> zero59);
    fi;

    out := List([1..Length(homBasis[1])], k -> zero59);

    for i in [1..Length(coeffs)] do
        if coeffs[i] <> zero59 then
            for k in [1..Length(out)] do
                out[k] := out[k] + coeffs[i] * homBasis[i][k];
            od;
        fi;
    od;

    return out;
end;;

RandomMapRows59 := function(H)
    local coeffs, vec;

    coeffs := RandomCoeffsAllowZero59(H.homDim);
    vec := LinearComboHomVec59(coeffs, H.basis, H.sourceDim, H.targetDim);

    return rec(
        coeffs := coeffs,
        rows := HomVecToRows59(vec, H.sourceDim, H.targetDim)
    );
end;;

EmbedToV27_59 := function(row, targetLabel)
    local out, i;

    out := ZeroVec59(27);

    if targetLabel = "1" then
        out[1] := row[1];
    elif targetLabel = "12" then
        for i in [1..12] do
            out[1+i] := row[i];
        od;
    elif targetLabel = "14" then
        for i in [1..14] do
            out[13+i] := row[i];
        od;
    else
        Error("Unknown targetLabel.");
    fi;

    return out;
end;;

AddVec59 := function(a, b)
    local out, i;

    out := [];

    for i in [1..Length(a)] do
        Add(out, a[i] + b[i]);
    od;

    return out;
end;;

ScalarVec59 := function(c, v)
    return List(v, x -> c*x);
end;;

############################################################
# Build one random commutative unital product on V27
#
# Basis:
#   index 1       = identity e
#   indices 2..13 = V12
#   indices 14..27 = V14
############################################################

BuildRandomProduct59 := function()
    local pdata12, pdata14,
          mS12_1, mS12_12, mS12_14,
          mT_1, mT_12, mT_14,
          mS14_1, mS14_12, mS14_14,
          prod, i, j, a, b, q, out, row;

    pdata12 := BuildSymPairData59(12);
    pdata14 := BuildSymPairData59(14);

    mS12_1  := RandomMapRows59(H_S12_to_1_59);
    mS12_12 := RandomMapRows59(H_S12_to_12_59);
    mS12_14 := RandomMapRows59(H_S12_to_14_59);

    mT_1  := RandomMapRows59(H_T1214_to_1_59);
    mT_12 := RandomMapRows59(H_T1214_to_12_59);
    mT_14 := RandomMapRows59(H_T1214_to_14_59);

    mS14_1  := RandomMapRows59(H_S14_to_1_59);
    mS14_12 := RandomMapRows59(H_S14_to_12_59);
    mS14_14 := RandomMapRows59(H_S14_to_14_59);

    prod := [];

    for i in [1..27] do
        prod[i] := [];
        for j in [1..27] do
            prod[i][j] := ZeroVec59(27);
        od;
    od;

    for i in [1..27] do
        for j in [i..27] do

            if i = 1 and j = 1 then
                out := BasisVec59(27, 1);

            elif i = 1 then
                out := BasisVec59(27, j);

            elif j = 1 then
                out := BasisVec59(27, i);

            elif i >= 2 and i <= 13 and j >= 2 and j <= 13 then
                a := i - 1;
                b := j - 1;
                q := pdata12.pairIndex[a][b];

                out := ZeroVec59(27);
                out := AddVec59(out, EmbedToV27_59(mS12_1.rows[q], "1"));
                out := AddVec59(out, EmbedToV27_59(mS12_12.rows[q], "12"));
                out := AddVec59(out, EmbedToV27_59(mS12_14.rows[q], "14"));

            elif i >= 2 and i <= 13 and j >= 14 and j <= 27 then
                a := i - 1;
                b := j - 13;
                q := (a-1)*14 + b;

                out := ZeroVec59(27);
                out := AddVec59(out, EmbedToV27_59(mT_1.rows[q], "1"));
                out := AddVec59(out, EmbedToV27_59(mT_12.rows[q], "12"));
                out := AddVec59(out, EmbedToV27_59(mT_14.rows[q], "14"));

            elif i >= 14 and i <= 27 and j >= 14 and j <= 27 then
                a := i - 13;
                b := j - 13;
                q := pdata14.pairIndex[a][b];

                out := ZeroVec59(27);
                out := AddVec59(out, EmbedToV27_59(mS14_1.rows[q], "1"));
                out := AddVec59(out, EmbedToV27_59(mS14_12.rows[q], "12"));
                out := AddVec59(out, EmbedToV27_59(mS14_14.rows[q], "14"));

            else
                # This is the 14 x 12 case; use symmetry from 12 x 14.
                out := prod[j][i];
            fi;

            prod[i][j] := out;
            prod[j][i] := out;
        od;
    od;

    return rec(
        prod := prod,
        coeffs := rec(
            S12_1 := mS12_1.coeffs,
            S12_12 := mS12_12.coeffs,
            S12_14 := mS12_14.coeffs,
            T_1 := mT_1.coeffs,
            T_12 := mT_12.coeffs,
            T_14 := mT_14.coeffs,
            S14_1 := mS14_1.coeffs,
            S14_12 := mS14_12.coeffs,
            S14_14 := mS14_14.coeffs
        )
    );
end;;

############################################################
# Product of arbitrary vectors
############################################################

ProdVec59 := function(u, v, prod)
    local out, i, j, k, coeff, p;

    out := ZeroVec59(27);

    for i in [1..27] do
        if u[i] <> zero59 then
            for j in [1..27] do
                if v[j] <> zero59 then
                    coeff := u[i] * v[j];
                    p := prod[i][j];

                    for k in [1..27] do
                        out[k] := out[k] + coeff * p[k];
                    od;
                fi;
            od;
        fi;
    od;

    return out;
end;;

RandomVec59 := function(d)
    local elts;

    elts := Elements(F59);
    return List([1..d], i -> Random(elts));
end;;

JordanRandomFailures59 := function(prod, ntests)
    local count, r, x, y, x2, yx, left, right;

    count := 0;

    for r in [1..ntests] do
        x := RandomVec59(27);
        y := RandomVec59(27);

        x2 := ProdVec59(x, x, prod);
        yx := ProdVec59(y, x, prod);

        left := ProdVec59(ProdVec59(x2, y, prod), x, prod);
        right := ProdVec59(x2, yx, prod);

        if left <> right then
            count := count + 1;
        fi;
    od;

    return count;
end;;

############################################################
# Derivation algebra computation
#
# D is a derivation if:
#   D(x*y) = D(x)*y + x*D(y)
#
# Unknown D is a 27 x 27 matrix, row convention.
# Variables D[i,a].
############################################################

DerivationBasis59 := function(prod)
    local d, numVars, varIndex, rows, i, j, b, row,
          p, k, a, raw, good;

    d := 27;
    numVars := d*d;

    varIndex := function(i, a)
        return (i-1)*d + a;
    end;

    rows := [];

    for i in [1..d] do
        for j in [i..d] do

            p := prod[i][j];

            for b in [1..d] do
                row := List([1..numVars], x -> zero59);

                # D(e_i * e_j)
                for k in [1..d] do
                    if p[k] <> zero59 then
                        row[varIndex(k,b)] := row[varIndex(k,b)] + p[k];
                    fi;
                od;

                # - D(e_i) * e_j
                for a in [1..d] do
                    if prod[a][j][b] <> zero59 then
                        row[varIndex(i,a)] := row[varIndex(i,a)] - prod[a][j][b];
                    fi;
                od;

                # - e_i * D(e_j)
                for a in [1..d] do
                    if prod[i][a][b] <> zero59 then
                        row[varIndex(j,a)] := row[varIndex(j,a)] - prod[i][a][b];
                    fi;
                od;

                Add(rows, row);
            od;
        od;
    od;

    raw := NullspaceMat(rows);

    if Length(raw) = 0 then
        return [];
    fi;

    if Length(raw[1]) = numVars then
        return raw;
    fi;

    # fallback orientation
    raw := NullspaceMat(TransposedMat(rows));

    if Length(raw) = 0 then
        return [];
    fi;

    if Length(raw[1]) = numVars then
        return raw;
    fi;

    return [];
end;;

DerivationDimension59 := function(prod)
    return Length(DerivationBasis59(prod));
end;;

