F7_44B := GF(7);;
one7_44B := One(F7_44B);;
zero7_44B := Zero(F7_44B);;

############################################################
# Helper functions
############################################################

SignedGF7_44B := function(x)
    local n;

    for n in [-3..3] do
        if n * one7_44B = x then
            return n;
        fi;
    od;

    return x;
end;;

MatDim44B := function(A)
    if IsList(A) and Length(A) > 0 and IsList(A[1]) then
        return [Length(A), Length(A[1])];
    fi;

    return fail;
end;;

TraceMat44B := function(A)
    local d, i, s;

    d := Length(A);
    s := zero7_44B;

    for i in [1..d] do
        s := s + A[i][i];
    od;

    return s;
end;;

SignedTrace44B := function(A)
    return SignedGF7_44B(TraceMat44B(A));
end;;

ActExp44B := function(g, x)
    local gx, k;

    gx := g^x;

    for k in [0..12] do
        if gx = g^k then
            return k;
        fi;
    od;

    return fail;
end;;

FindAllBruhatWitnesses44B := function(g, f, t)
    local out, i, j, b;

    out := [];

    for i in [0..12] do
        for j in [0..5] do
            b := g^i * f^j;

            if b*t <> One(Parent(g)) and Order(b*t) = 3 then
                Add(out, [i,j]);
            fi;
        od;
    od;

    return out;
end;;

ChooseBestT44B := function(g, f, goodTRecs)
    local r, w;

    # First preference: Order(g*t)=3
    for r in goodTRecs do
        if Order(g*r.t) = 3 then
            return r;
        fi;
    od;

    # Second preference: pure-g witness g^i*t has order 3
    for r in goodTRecs do
        for w in r.witnesses do
            if w[2] = 0 then
                return r;
            fi;
        od;
    od;

    # Otherwise just take first exact-inverting Bruhat t
    return goodTRecs[1];
end;;

BlockDiag2_44B := function(A, B)
    local da, db, z, M, i, rightzero, leftzero;

    da := Length(A);
    db := Length(B);
    z := Zero(A[1][1]);

    M := [];

    rightzero := List([1..db], k -> z);
    for i in [1..da] do
        Add(M, Concatenation(A[i], rightzero));
    od;

    leftzero := List([1..da], k -> z);
    for i in [1..db] do
        Add(M, Concatenation(leftzero, B[i]));
    od;

    return M;
end;;

############################################################
# Extract generator matrices from module record
############################################################

ExtractGenMats44B := function(r)
    local names, nm, val;

    if IsRecord(r) then
        names := RecNames(r);

        for nm in ["generators", "gens", "matrices", "mats", "genimages", "images"] do
            if nm in names then
                val := r.(nm);

                if IsList(val) and Length(val) > 0 then
                    return val;
                fi;
            fi;
        od;

        Print("  record names = ", names, "\n");
        return fail;
    fi;

    # Sometimes the record is already a list of matrices
    if IsList(r) and Length(r) > 0 then
        return r;
    fi;

    return fail;
end;;

BuildImageTable44B := function(H, gensH, gensM)
    local elems, imgs, pos, k, y, p;

    elems := [One(H)];
    imgs := [One(Group(gensM))];

    pos := 1;

    while pos <= Length(elems) do
        for k in [1..Length(gensH)] do
            y := elems[pos] * gensH[k];
            p := Position(elems, y);

            if p = fail then
                Add(elems, y);
                Add(imgs, imgs[pos] * gensM[k]);
            fi;
        od;

        pos := pos + 1;
    od;

    return rec(elems := elems, imgs := imgs);
end;;

ImageOfElement44B := function(tab, x)
    local p;

    p := Position(tab.elems, x);

    if p = fail then
        return fail;
    fi;

    return tab.imgs[p];
end;;

PrintProfile44B := function(name, g, f, t)
    Print("\n", name, "\n");
    Print("  dim = ", Length(g), "\n");
    Print("  Order(g)   = ", Order(g),   " | trace(g)   = ", SignedTrace44B(g), "\n");
    Print("  Order(f)   = ", Order(f),   " | trace(f)   = ", SignedTrace44B(f), "\n");
    Print("  Order(f^2) = ", Order(f^2), " | trace(f^2) = ", SignedTrace44B(f^2), "\n");
    Print("  Order(f^3) = ", Order(f^3), " | trace(f^3) = ", SignedTrace44B(f^3), "\n");
    Print("  Order(t)   = ", Order(t),   " | trace(t)   = ", SignedTrace44B(t), "\n");
    Print("  Order(g*t) = ", Order(g*t), " | trace(g*t) = ", SignedTrace44B(g*t), "\n");
    Print("  f^t=f^-1? ", f^t = f^-1, "\n");
    Print("  Size(<g,f>) = ", Size(Group(g,f)), "\n");
    Print("  Size(<g,f,t>) = ", Size(Group(g,f,t)), "\n");
end;;

