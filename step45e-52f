        fi;
    od;

    return true;
end;;

FilterZeroRows54A := function(rows)
    return Filtered(rows, r -> not IsZeroRow54A(r));
end;;

RankRows54A := function(rows)
    if Length(rows) = 0 then
        return 0;
    fi;

    return RankMat(rows);
end;;

LieDimFromRows54A := function(rows, nvars)
    return nvars - RankRows54A(rows);
end;;

VecSupportSize54A := function(v)
    local n, x;

    n := 0;

    for x in v do
        if x <> zero45E then
            n := n + 1;
        fi;
    od;

    return n;
end;;

############################################################
# Build Lie equations for preserving symmetric form S
#
# Row action group condition:
#       A*S*A^T = S
#
# Lie algebra condition:
#       X*S + S*X^T = 0
############################################################

LieRowsForSymmetricForm54A := function(S)
    local d, nvars, rows, i, j, r, s, row, v;

    d := Length(S);
    nvars := d*d;
    rows := [];

    for i in [1..d] do
        for j in [1..d] do
            row := List([1..nvars], k -> zero45E);

            # X*S contribution
            for r in [1..d] do
                if S[r][j] <> zero45E then
                    v := VarIndex54A(d, i, r);
                    row[v] := row[v] + S[r][j];
                fi;
            od;

            # S*X^T contribution
            for s in [1..d] do
                if S[i][s] <> zero45E then
                    v := VarIndex54A(d, j, s);
                    row[v] := row[v] + S[i][s];
                fi;
            od;

            if not IsZeroRow54A(row) then
                Add(rows, row);
            fi;
        od;
    od;

    return rows;
end;;

############################################################
# Build Lie equations for preserving cubic covector c
#
# If c is fixed by group action on Sym^3(V), then the Lie condition is:
#
#       c * D_X = 0
#
# where D_X is the derivative of the Sym^3 action.
#
# Variables are entries X[i,j], where row vector e_i maps infinitesimally
# to sum_j X[i,j] e_j.
############################################################

LieRowsForCubic54A := function(cvec, data)
    local d, nmon, nvars, rows, supp, p, coeff, mon,
          pos, old, r, newmon, q, v, pc;

    d := data.d;
    nmon := data.dim;
    nvars := d*d;

    Print("  cubic support size = ", VecSupportSize54A(cvec), "\n");

    rows := List([1..nmon], i -> List([1..nvars], j -> zero45E));

    supp := [];

    for p in [1..nmon] do
        if cvec[p] <> zero45E then
            Add(supp, [p, cvec[p]]);
        fi;
    od;

    for pc in supp do
        p := pc[1];
        coeff := pc[2];
        mon := data.basis[p];

        # Replace each of the three positions by r.
        # This correctly counts multiplicities when indices repeat.
        for pos in [1..3] do
            old := mon[pos];

            for r in [1..d] do
                newmon := ShallowCopy(mon);
                newmon[pos] := r;
                Sort(newmon);

                q := data.index3[newmon[1]][newmon[2]][newmon[3]];
                v := VarIndex54A(d, old, r);

                rows[q][v] := rows[q][v] + coeff;
            od;
        od;
    od;

    rows := FilterZeroRows54A(rows);

    Print("  nonzero cubic Lie rows = ", Length(rows), "\n");

    return rows;
end;;

############################################################
