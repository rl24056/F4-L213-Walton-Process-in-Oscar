end;;

ElementaryMat62B := function(d, i, j)
    local M;
    M := ZeroMat62B(d);
    M[i][j] := One(F62);
    return M;
end;;

FlatMat62B := function(M)
    local v, i;
    v := [];
    for i in [1..Length(M)] do
        Append(v, M[i]);
    od;
    return v;
end;;

NonzeroVec62B := function(v)
    return ForAny(v, x -> x <> Zero(F62));
end;;

RankRows62B := function(rows)
    if Length(rows) = 0 then
        return 0;
    fi;
    return RankMat(rows);
end;;

AddMatToState62B := function(state, M)
    local v, newrows, r;

    v := FlatMat62B(M);

    if not NonzeroVec62B(v) then
        return false;
    fi;

    newrows := ShallowCopy(state.basisVecs);
    Add(newrows, v);

    r := RankMat(newrows);

    if r > state.rank then
        Add(state.basisVecs, v);
        Add(state.basisMats, M);
        state.rank := r;
        return true;
    fi;

    return false;
end;;

ClosureFromSeeds62B := function(seedMats, actionGens, maxDim)
    local state, queue, q, M, A, Y;

    state := rec(
        basisVecs := [],
        basisMats := [],
        rank := 0,
        overflow := false
    );

    queue := [];

    for M in seedMats do
        if AddMatToState62B(state, M) then
            Add(queue, M);
        fi;
    od;

    q := 1;

    while q <= Length(queue) do
        M := queue[q];
        q := q + 1;

        for A in actionGens do
            Y := A^-1 * M * A;

            if AddMatToState62B(state, Y) then
                Add(queue, Y);
            fi;

            if state.rank > maxDim then
                state.overflow := true;
                return state;
            fi;
        od;
    od;

    return state;
end;;

InSpanRows62B := function(rows, v)
    local newrows;

    if not NonzeroVec62B(v) then
        return true;
    fi;

    newrows := ShallowCopy(rows);
    Add(newrows, v);

    return RankMat(newrows) = RankRows62B(rows);
end;;

CommutatorMat62B := function(A, B)
    return A*B - B*A;
end;;

BracketFailureCount62B := function(state, maxPairs)
    local n, i, j, tested, C, v, fails;

    n := Length(state.basisMats);
    tested := 0;
    fails := 0;

    for i in [1..n] do
        for j in [i+1..n] do
            C := CommutatorMat62B(state.basisMats[i], state.basisMats[j]);
            v := FlatMat62B(C);

            if not InSpanRows62B(state.basisVecs, v) then
                fails := fails + 1;
            fi;

            tested := tested + 1;

            if maxPairs <> "all" and tested >= maxPairs then
                return rec(tested := tested, failures := fails);
            fi;
        od;
    od;

    return rec(tested := tested, failures := fails);
end;;

AddSmallSubmodule62B := function(list, C)
    local E, r;

    for E in list do
        r := RankMat(Concatenation(E.basisVecs, C.basisVecs));
        if r = E.rank and C.rank = E.rank then
            return false;
        fi;
    od;

    Add(list, C);
    return true;
end;;

TestSeedQuiet62B := function(label, M)
    local C, quick, full;

    C := ClosureFromSeeds62B([M], ActionGens62B, MAX_CLOSURE_DIM62B);

    Add(SeedResults62B,
        rec(label := label, dim := C.rank, overflow := C.overflow));

    Print("Seed ", label,
          " -> H-closure dim ", C.rank,
          ", overflow=", C.overflow, "\n");

    if C.rank = 12 then
        if AddSmallSubmodule62B(Small12_62B, C) then
            Print("  New 12-submodule. Total = ",
                  Length(Small12_62B), "\n");
        fi;
    fi;

    if C.rank = 14 then
        if AddSmallSubmodule62B(Small14_62B, C) then
            Print("  New 14-submodule. Total = ",
                  Length(Small14_62B), "\n");
        fi;
    fi;

    if C.rank = 52 then
        Print("  Candidate 52-dimensional H-submodule found.\n");

        quick := BracketFailureCount62B(C, 200);
        Print("  Quick bracket test failures = ",
              quick.failures, " / ", quick.tested, "\n");

        if quick.failures = 0 then
            full := BracketFailureCount62B(C, "all");
            Print("  FULL bracket test failures = ",
                  full.failures, " / ", full.tested, "\n");

            if full.failures = 0 then
                Print("  *** GOOD 52D BRACKET-CLOSED LIE SUBSPACE FOUND ***\n");
                Add(Good52_62B, rec(label := label, space := C));
            fi;
        fi;
    fi;

    return true;
end;;

