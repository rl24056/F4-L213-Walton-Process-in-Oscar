IsMatrixLike42B := function(A)
    if not IsList(A) then
        return false;
    fi;

    if Length(A) = 0 then
        return false;
    fi;

    if not IsList(A[1]) then
        return false;
    fi;

    if Length(A[1]) = 0 then
        return false;
    fi;

    if IsList(A[1][1]) then
        return false;
    fi;

    return true;
end;;

IsModuleGensList42B := function(M)
    local d, x;

    if not IsList(M) then
        return false;
    fi;

    if Length(M) = 0 then
        return false;
    fi;

    if not IsMatrixLike42B(M[1]) then
        return false;
    fi;

    d := Length(M[1]);

    for x in M do
        if not IsMatrixLike42B(x) then
            return false;
        fi;

        if Length(x) <> d then
            return false;
        fi;
    od;

    return true;
end;;

ModuleDimFromGens42B := function(M)
    if not IsModuleGensList42B(M) then
        Error("Input is not a module generator list.");
    fi;

    return Length(M[1]);
end;;

CollectModuleLists42B := function(x)
    local out, y, nm;

    out := [];

    if IsModuleGensList42B(x) then
        Add(out, x);
        return out;
    fi;

    if IsMatrixLike42B(x) then
        return out;
    fi;

    if IsRecord(x) then
        for nm in RecNames(x) do
            Append(out, CollectModuleLists42B(x.(nm)));
        od;

        return out;
    fi;

    if IsList(x) then
        for y in x do
            Append(out, CollectModuleLists42B(y));
        od;

        return out;
    fi;

    return out;
end;;

AddIfNewModuleList42B := function(L, M)
    local N;

    for N in L do
        if N = M then
            return;
        fi;
    od;

    Add(L, M);
end;;

BuildImageHomFromGens42B := function(H, gensM)
    local gensH, HM, hom;

    gensH := GeneratorsOfGroup(H);
    HM := Group(gensM);

    hom := GroupHomomorphismByImages(H, HM, gensH, gensM);

    return rec(group := HM, hom := hom);
end;;

############################################################
# PART 3. Abstract PSL2(13) Walton triple
############################################################

FindAbstractWaltonTriple42B := function(H)
    local elts, invols, order13s, g, P, N, f, B, t, wit, best;

    elts := Elements(H);
    invols := Filtered(elts, x -> Order(x) = 2);
    order13s := Filtered(elts, x -> Order(x) = 13);

    best := fail;

    Print("Abstract search: order-13 elements = ", Length(order13s), "\n");
    Print("Abstract search: involutions = ", Length(invols), "\n");

    for g in order13s do
        P := Group(g);
        N := Normalizer(H, P);

        for f in Elements(N) do
            if Order(f) = 6 and ActionExponentCyclic42B(g, f) = 10 then
                B := Group(g, f);

                if Size(B) = 78 then
                    for t in invols do
                        if f^t = f^-1
                           and not (t in B)
                           and ActionExponentCyclic42B(g, t) = fail
                           and Size(Group(g, f, t)) = Size(H) then

                            wit := FindBruhatWitness42B(g, f, t);

                            if wit <> fail then
                                if wit.i = 1 and wit.j = 0 then
                                    return rec(
                                        g := g,
                                        f := f,
                                        t := t,
                                        B := B,
                                        witness := wit
                                    );
                                fi;

                                if best = fail then
                                    best := rec(
                                        g := g,
                                        f := f,
                                        t := t,
                                        B := B,
                                        witness := wit
                                    );
                                fi;
                            fi;
                        fi;
                    od;
                fi;
            fi;
        od;
    od;

    return best;
end;;

