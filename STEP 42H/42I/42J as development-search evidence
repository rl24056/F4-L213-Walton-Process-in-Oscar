end;;

BottomRightBlock42J := function(A, d)
    local n, m, C, i, j;

    n := Length(A);
    m := n - d;

    C := NullMat(m, m, F7_42J);

    for i in [1..m] do
        for j in [1..m] do
            C[i][j] := A[d+i][d+j];
        od;
    od;

    return C;
end;;

