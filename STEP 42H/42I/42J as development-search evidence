    Print("Stop here.\n");

else

    Print("Loaded ordinary character table: ", Identifier(tbl43E), "\n");

    br43E := BrauerTable(tbl43E, 7);;

    if br43E = fail then

        Print("BrauerTable(tbl,7) failed.\n");
        Print("Stop here.\n");

    else

        Print("Loaded Brauer table in characteristic 7: ",
              Identifier(br43E), "\n");

        orders43E := OrdersClassRepresentatives(br43E);;
        sizes43E := SizesConjugacyClasses(br43E);;
        irr43E := Irr(br43E);;

        Print("Brauer class orders = ", orders43E, "\n");
        Print("Brauer class sizes  = ", sizes43E, "\n");
        Print("Number of irreducible Brauer characters = ",
              Length(irr43E), "\n");

        ############################################################
