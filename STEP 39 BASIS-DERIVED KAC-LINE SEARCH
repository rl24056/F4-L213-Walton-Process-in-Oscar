CmatF4a_32 := [
    [ 2, -1,  0,  0],
    [-1,  2, -2,  0],
    [ 0, -1,  2, -1],
    [ 0,  0, -1,  2]
];;

CmatF4b_32 := [
    [ 2, -1,  0,  0],
    [-1,  2, -1,  0],
    [ 0, -2,  2, -1],
    [ 0,  0, -1,  2]
];;

ExpModeWithCartan32 := function(r, kac, mode, C)
    local CT, s, i, j;

    CT := TransposedMat(C);
    s := 0;

    if mode = 1 then
        for i in [1..4] do
            s := s + r[i] * kac[i];
        od;
    fi;

    if mode = 2 then
        for i in [1..4] do
            for j in [1..4] do
                s := s + r[i] * C[i][j] * kac[j];
            od;
        od;
    fi;

    if mode = 3 then
        for i in [1..4] do
            for j in [1..4] do
                s := s + r[i] * CT[i][j] * kac[j];
            od;
        od;
    fi;

    if mode = 4 then
        for i in [1..4] do
            for j in [1..4] do
                s := s + kac[i] * C[i][j] * r[j];
            od;
        od;
    fi;

    if mode = 5 then
        for i in [1..4] do
            for j in [1..4] do
                s := s + kac[i] * CT[i][j] * r[j];
            od;
        od;
    fi;

    return s mod 13;
end;;

DiagMatFromListExt32 := function(diag)
    local n, M, i;

    n := Length(diag);
    M := NullMat(n, n, Fext32);

    for i in [1..n] do
        M[i][i] := diag[i];
    od;

    return M;
end;;

BuildGExtFromKacLineConvention32 := function(kac, mode, C)
    local diag, r, e, i;

    diag := [];

    for r in posRootsSimple32 do
        e := ExpModeWithCartan32(r, kac, mode, C);
        Add(diag, zeta13_32^e);
    od;

    for r in posRootsSimple32 do
        e := (-ExpModeWithCartan32(r, kac, mode, C)) mod 13;
        Add(diag, zeta13_32^e);
    od;

    for i in [1..4] do
        Add(diag, oneExt32);
    od;

    return DiagMatFromListExt32(diag);
end;;

FindGoodKacConvention32 := function()
    local testLine, cartanList, cIndex, C, mode, g, act;

    testLine := [1,3,8,12];
    cartanList := [CmatF4a_32, CmatF4b_32];

    Print("Testing known Kac line ", testLine, "\n");

    for cIndex in [1..Length(cartanList)] do
        C := cartanList[cIndex];

        for mode in [1..5] do
            g := BuildGExtFromKacLineConvention32(testLine, mode, C);
            act := ActionExponentOnGExt32(g, fExt32);

            Print("\nCartan choice ", cIndex, ", mode ", mode, "\n");
            Print("  g^13 = 1? ", g^13 = One52Ext32, "\n");
            Print("  g <> 1? ", g <> One52Ext32, "\n");
            Print("  Trace(g)=0? ", TraceIsZero32(g), "\n");
            Print("  action exponent of f on <g> = ", act, "\n");
            Print("  g^f = g^10? ", g^fExt32 = g^10, "\n");
            Print("  g^f = g^4 ? ", g^fExt32 = g^4, "\n");

            if TraceIsZero32(g) and act = 10 then
                Print("\nGOOD CONVENTION FOUND.\n");
                Print("Cartan choice = ", cIndex, ", mode = ", mode, "\n");
                return [cIndex, mode];
            fi;
        od;
    od;

    return fail;
end;;

GoodKacConvention32 := FindGoodKacConvention32();;

