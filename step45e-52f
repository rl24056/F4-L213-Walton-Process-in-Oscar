Ext2BasisData51A := function(d)
    local basis, index, i, j;

    basis := [];
    index := List([1..d], i -> List([1..d], j -> 0));

    for i in [1..d-1] do
        for j in [i+1..d] do
            Add(basis, [i,j]);
            index[i][j] := Length(basis);
            index[j][i] := Length(basis);
        od;
    od;

    return rec(
        d := d,
        basis := basis,
        index := index,
        dim := Length(basis)
    );
end;;

RowSupports51A := function(A)
    local d, supps, i, j, rowSupp;

    d := Length(A);
    supps := [];

    for i in [1..d] do
        rowSupp := [];

        for j in [1..d] do
            if A[i][j] <> zero45E then
                Add(rowSupp, [j, A[i][j]]);
            fi;
        od;

        Add(supps, rowSupp);
    od;

    return supps;
end;;

Ext2Matrix51A := function(A, data)
    local d, n, supps, rows, bidx, mon, a, b,
          row, rr, ss, coeff, q;

    d := data.d;
    n := data.dim;
    supps := RowSupports51A(A);
    rows := [];

    for bidx in [1..n] do
        mon := data.basis[bidx];
        a := mon[1];
        b := mon[2];

        row := List([1..n], i -> zero45E);

        for rr in supps[a] do
            for ss in supps[b] do
                if rr[1] <> ss[1] then
                    coeff := rr[2] * ss[2];

                    if rr[1] < ss[1] then
                        q := data.index[rr[1]][ss[1]];
                        row[q] := row[q] + coeff;
                    else
                        q := data.index[ss[1]][rr[1]];
                        row[q] := row[q] - coeff;
                    fi;
                fi;
            od;
        od;

        Add(rows, row);
    od;

    return rows;
end;;

BuildExt2Module51A := function(mats)
    local d, data, extMats, A;

    d := Length(mats[1]);
    data := Ext2BasisData51A(d);
    extMats := [];

    for A in mats do
        Add(extMats, Ext2Matrix51A(A, data));
    od;

    return rec(
