BlockDiag2_62 := function(A, B)
    local d1, d2, z, M, i, j;

    d1 := Length(A);
    d2 := Length(B);
    z := Zero(F62);

    M := List([1..d1+d2], i -> List([1..d1+d2], j -> z));

    for i in [1..d1] do
        for j in [1..d1] do
            M[i][j] := A[i][j];
        od;
    od;

    for i in [1..d2] do
        for j in [1..d2] do
            M[d1+i][d1+j] := B[i][j];
        od;
    od;

    return M;
end;;

