F7_42F := GF(7);;
one7_42F := One(F7_42F);;
zero7_42F := 0 * one7_42F;;

############################################################
# PART 1. Helper functions
############################################################

TraceMat42F := function(A)
    local s, i;

    s := zero7_42F;

    for i in [1..Length(A)] do
        s := s + A[i][i];
    od;

    return s;
end;;

TraceLabel42F := function(x)
    if x = 0 * one7_42F then
        return "0";
    elif x = 1 * one7_42F then
        return "1";
    elif x = -1 * one7_42F then
        return "-1";
    elif x = 2 * one7_42F then
        return "2";
    elif x = -2 * one7_42F then
        return "-2";
    elif x = -4 * one7_42F then
        return "-4";
    else
        return String(x);
    fi;
end;;

TraceLabel26_42F := function(x)
    if x = 0 * one7_42F then
        return "0";
    elif x = 1 * one7_42F then
        return "1";
    elif x = -1 * one7_42F then
        return "-1";
    elif x = 2 * one7_42F then
        return "2";
    elif x = -2 * one7_42F then
        return "-2";
    else
