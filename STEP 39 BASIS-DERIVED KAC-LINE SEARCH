RunStep38B_AllKacLines32 := function()
    local KacLines32_local, AllLineResults32_local;
    local lineNo, kac, g, actionF;
    local BRecords, BMats, distinctBCount;
    local basicGoodIndices, hitRecords;
    local idx, t, actionT, witnesses, r;

