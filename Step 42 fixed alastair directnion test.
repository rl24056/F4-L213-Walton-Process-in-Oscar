PrintTraceLineG242B := function(name, x12, x14)
    local tr12, tr14, tr26, tr38, tr52;

    tr12 := TraceMat42B(x12);
    tr14 := TraceMat42B(x14);
    tr26 := tr12 + tr14;

    # Supervisor's possible G2 line:
    # L(F4)|G2 = L(G2) + V38
    # dimensions: 52 = 14 + 38
    # possible V38|H = 12 + 12 + 14
    # so total L(F4)|H = 14 + (12+12+14) = 2*12 + 2*14.
    tr38 := 2 * tr12 + tr14;
    tr52 := tr14 + tr38;

    Print("  ", name, "\n");
    Print("      trace on 12              = ", TraceLabelGeneral42B(tr12), "\n");
    Print("      trace on 14              = ", TraceLabelGeneral42B(tr14), "\n");
    Print("      trace on 26 = 12+14      = ", TraceLabel26_42B(tr26), "\n");
    Print("      G2 test: L(G2) 14-part   = ", TraceLabelGeneral42B(tr14), "\n");
    Print("      G2 test: V38=12+12+14    = ", TraceLabelGeneral42B(tr38), "\n");
    Print("      total 52 = 14+38         = ", TraceLabel52_42B(tr52), "\n");
end;;

