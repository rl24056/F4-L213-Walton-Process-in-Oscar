PairData45E := function(d)
    local pairs, pairIndex, i, j;

    pairs := [];
    pairIndex := List([1..d], i -> List([1..d], j -> 0));

    for i in [1..d-1] do
        for j in [i+1..d] do
            Add(pairs, [i,j]);
            pairIndex[i][j] := Length(pairs);
            pairIndex[j][i] := Length(pairs);
        od;
    od;

    return rec(pairs := pairs, pairIndex := pairIndex);
end;;

VarIndex45E := function(p, k, d)
    return (p-1)*d + k;
end;;

AltHomBasis45E := function(mats)
    local d, pdata, pairs, pairIndex, npairs, nvars, rows,
          A, p, i, j, k, r, s, l, q, coeff, row;

    d := Length(mats[1]);
    pdata := PairData45E(d);
    pairs := pdata.pairs;
    pairIndex := pdata.pairIndex;
    npairs := Length(pairs);
    nvars := npairs * d;

    rows := [];

    for A in mats do
        for p in [1..npairs] do
            i := pairs[p][1];
            j := pairs[p][2];

            for k in [1..d] do
                row := List([1..nvars], x -> zero45E);

                for r in [1..d] do
                    if A[i][r] <> zero45E then
                        for s in [1..d] do
                            if A[j][s] <> zero45E then
                                coeff := A[i][r] * A[j][s];

                                if r < s then
                                    q := pairIndex[r][s];
                                    row[VarIndex45E(q,k,d)] :=
                                        row[VarIndex45E(q,k,d)] + coeff;
                                elif r > s then
                                    q := pairIndex[s][r];
                                    row[VarIndex45E(q,k,d)] :=
                                        row[VarIndex45E(q,k,d)] - coeff;
                                fi;
                            fi;
                        od;
                    fi;
                od;

                for l in [1..d] do
                    if A[l][k] <> zero45E then
                        row[VarIndex45E(p,l,d)] :=
                            row[VarIndex45E(p,l,d)] - A[l][k];
                    fi;
                od;

                Add(rows, row);
            od;
        od;
    od;

    return rec(
        basis := NullspaceMat(rows),
        pairs := pairs,
        pairIndex := pairIndex,
        d := d,
        npairs := npairs,
        nvars := nvars
    );
end;;

MapRowsFromVector45E := function(vec, d, npairs)
    local rows, p, k;

    rows := [];

    for p in [1..npairs] do
        Add(rows, List([1..d], k -> vec[VarIndex45E(p,k,d)]));
    od;

    return rows;
end;;

CombineVectors45E := function(basis, coeffs)
    local n, v, i, j;

    n := Length(basis[1]);
    v := List([1..n], i -> zero45E);

    for i in [1..Length(coeffs)] do
        if coeffs[i] <> zero45E then
            for j in [1..n] do
                v[j] := v[j] + coeffs[i] * basis[i][j];
            od;
        fi;
    od;

    return v;
end;;

ZeroVec45E := function(d)
    return List([1..d], i -> zero45E);
end;;

IsZeroVec45E := function(v)
    local x;

    for x in v do
        if x <> zero45E then
            return false;
        fi;
    od;

    return true;
end;;

AddVec45E := function(a, b)
    local d, c, i;

    d := Length(a);
    c := [];

    for i in [1..d] do
        Add(c, a[i] + b[i]);
    od;

    return c;
end;;

BracketPair45E := function(mapRows, pairIndex, a, b)
    local d, p, row, k;

    d := Length(mapRows[1]);

    if a = b then
        return ZeroVec45E(d);
    fi;

    if a < b then
        p := pairIndex[a][b];
        return ShallowCopy(mapRows[p]);
    else
        p := pairIndex[b][a];
        row := [];
        for k in [1..d] do
            Add(row, -mapRows[p][k]);
        od;
        return row;
    fi;
end;;

BracketBasisWithVector45E := function(mapRows, pairIndex, a, v)
    local d, out, b, coeff, temp, k;

    d := Length(v);
    out := ZeroVec45E(d);

    for b in [1..d] do
        coeff := v[b];

        if coeff <> zero45E then
            temp := BracketPair45E(mapRows, pairIndex, a, b);

            for k in [1..d] do
                out[k] := out[k] + coeff * temp[k];
            od;
        fi;
    od;

    return out;
end;;

JacobiFailures45E := function(mapRows, pairIndex)
    local d, i, j, k, vjk, vki, vij, term1, term2, term3, total, fails;

    d := Length(mapRows[1]);
    fails := 0;

    for i in [1..d-2] do
        for j in [i+1..d-1] do
            for k in [j+1..d] do
                vjk := BracketPair45E(mapRows, pairIndex, j, k);
                vki := BracketPair45E(mapRows, pairIndex, k, i);
                vij := BracketPair45E(mapRows, pairIndex, i, j);

                term1 := BracketBasisWithVector45E(mapRows, pairIndex, i, vjk);
                term2 := BracketBasisWithVector45E(mapRows, pairIndex, j, vki);
                term3 := BracketBasisWithVector45E(mapRows, pairIndex, k, vij);

                total := AddVec45E(AddVec45E(term1, term2), term3);

                if not IsZeroVec45E(total) then
                    fails := fails + 1;
                fi;
            od;
        od;
    od;

    return fails;
end;;

ProjectiveCoeffTuples45E := function(n)
    local felts, res, tup, recur;

    felts := Elements(F45E);
    res := [];
    tup := List([1..n], i -> zero45E);

    recur := function(pos, seenOne)
        local a;

        if pos > n then
            if seenOne then
                Add(res, ShallowCopy(tup));
            fi;
            return;
        fi;

        if not seenOne then
            tup[pos] := zero45E;
            recur(pos+1, false);

            tup[pos] := one45E;
            recur(pos+1, true);
        else
            for a in felts do
                tup[pos] := a;
                recur(pos+1, true);
            od;
        fi;
    end;

    recur(1, false);

    return res;
end;;

