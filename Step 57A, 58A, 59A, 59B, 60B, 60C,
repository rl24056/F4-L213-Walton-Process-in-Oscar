GoodNullspace61 := function(rows, desiredLen)
    local raw, raw2;

    raw := NullspaceMat(rows);

    if Length(raw) = 0 then
        return [];
    fi;

    if Length(raw[1]) = desiredLen then
        return raw;
    fi;

    raw2 := NullspaceMat(TransposedMat(rows));

    if Length(raw2) = 0 then
        return [];
    fi;

    if Length(raw2[1]) = desiredLen then
        return raw2;
    fi;

    Print("Warning: could not find nullspace with vector length ",
          desiredLen, ".\n");
    Print("  first orientation length = ", Length(raw[1]), "\n");
    Print("  second orientation length = ", Length(raw2[1]), "\n");

    return fail;
end;;

############################################################
# Correct annihilator
#
# Ann(A) = {v | v*w = 0 for all w in A}
# Unknown vector has length 27.
############################################################

CorrectAnnihilatorBasis61 := function(prod)
    local d, rows, i, j, k, row;

    d := 27;
    rows := [];

    for j in [1..d] do
        for k in [1..d] do
            row := List([1..d], x -> zero61);

            for i in [1..d] do
                if prod[i][j][k] <> zero61 then
                    row[i] := row[i] + prod[i][j][k];
                fi;
            od;

            Add(rows, row);
        od;
    od;

    return GoodNullspace61(rows, d);
end;;

############################################################
# Product-image and square-span helpers
############################################################

ProductImageDim61 := function(prod, A, B)
    local rows, i, j;

    rows := [];

    for i in A do
        for j in B do
            Add(rows, prod[i][j]);
        od;
    od;

    return Length(BaseMat(rows));
end;;

SquareSpanDim61 := function(prod, A)
    local rows, i;

    rows := [];

    for i in A do
        Add(rows, prod[i][i]);
    od;

    return Length(BaseMat(rows));
end;;

IdentityCheck61 := function(prod)
    local i;

    for i in [1..27] do
        if prod[1][i] <> BasisVec59(27, i) then
            return false;
        fi;

        if prod[i][1] <> BasisVec59(27, i) then
            return false;
        fi;
    od;

    return true;
end;;

############################################################
# Jordan identity
############################################################

JordanFailureVec61 := function(prod, x, y)
    local x2, yx, left, right, diff, k;

    x2 := ProdVec59(x, x, prod);
    yx := ProdVec59(y, x, prod);

    left := ProdVec59(ProdVec59(x2, y, prod), x, prod);
    right := ProdVec59(x2, yx, prod);

    diff := [];

    for k in [1..27] do
        Add(diff, left[k] - right[k]);
    od;

    return diff;
end;;

IsZeroVec61 := function(v)
    return ForAll(v, x -> x = zero61);
end;;

BasisJordanFailures61 := function(prod)
    local failCount, i, j, x, y, diff;

    failCount := 0;

    for i in [1..27] do
        x := BasisVec59(27, i);

        for j in [1..27] do
            y := BasisVec59(27, j);
            diff := JordanFailureVec61(prod, x, y);

            if not IsZeroVec61(diff) then
                failCount := failCount + 1;
            fi;
        od;
    od;

    return failCount;
end;;

############################################################
