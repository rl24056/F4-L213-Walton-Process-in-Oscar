GF7EntryToSmallInt32 := function(a)
    local n;

    n := IntFFE(a);

    # Convert 0,1,2,3,4,5,6 into 0,1,2,3,-3,-2,-1.
    if n > 3 then
        n := n - 7;
    fi;

    return n;
end;;

InvMod13_32 := function(a)
    local k;

    a := a mod 13;

    for k in [1..12] do
        if (a * k) mod 13 = 1 then
            return k;
        fi;
    od;

    return fail;
end;;

NormalizeVecMod13_32 := function(v)
    local i, inv, w;

    w := List(v, x -> x mod 13);

    for i in [1..Length(w)] do
        if w[i] <> 0 then
            inv := InvMod13_32(w[i]);
            return List(w, x -> (x * inv) mod 13);
        fi;
    od;

    return fail;
end;;

