GetModuleGens62 := function(r)
    if IsRecord(r) then
        if IsBound(r.generators) then
            return r.generators;
        fi;
        if IsBound(r.gens) then
            return r.gens;
        fi;
        Print("Available record fields = ", RecNames(r), "\n");
        Error("Could not find generator matrices in this module record.");
    fi;

    if IsList(r) then
        return r;
    fi;

    Error("Unknown module record format.");
end;;

MakeHom62 := function(r)
    local mats, Gm;
    mats := GetModuleGens62(r);
    Gm := Group(mats);
    return GroupHomomorphismByImagesNC(H62, Gm, sourceGens62, mats);
end;;

ProfileRecord62 := function(r)
    local hom, mg, mf, mt, prof;

    hom := MakeHom62(r);

    mg := Image(hom, g62);
    mf := Image(hom, f62);
    mt := Image(hom, t62);

    prof := [
        TraceSigned62(mg),
        TraceSigned62(mf),
        TraceSigned62(mf^2),
        TraceSigned62(mf^3),
        TraceSigned62(mt),
        TraceSigned62(mg*mt)
    ];

    return rec(
        hom := hom,
        dim := MatDim62(mg),
        profile := prof,
        g := mg,
        f := mf,
        t := mt
    );
end;;

