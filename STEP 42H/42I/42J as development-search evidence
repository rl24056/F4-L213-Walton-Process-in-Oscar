    tr52_43D := 2 * tr12_43D + 2 * tr14_43D;;

    fd12_43D := FixedDim43B(x12_43D);;
    fd14_43D := FixedDim43B(x14_43D);;
    fd26_43D := fd12_43D + fd14_43D;;
    fd38_43D := 2 * fd12_43D + fd14_43D;;
    fd52_43D := 2 * fd12_43D + 2 * fd14_43D;;

    Add(ClassData43D, rec(
        originalIndex := i43D,
        cls := classes43D[i43D],
        rep := x43D,
        order := Order(x43D),
        size := Size(classes43D[i43D]),
