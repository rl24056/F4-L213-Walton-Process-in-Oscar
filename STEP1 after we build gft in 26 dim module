RandomNonzeroGF7_62B := function()
    local x;
    x := Zero(F62);
    while x = Zero(F62) do
        x := Random(F62);
    od;
    return x;
end;;

RandomSparseMat62B := function(d, support)
    local M, k, i, j;

    M := NullMat(d, d, F62);

    for k in [1..support] do
        i := Random([1..d]);
        j := Random([1..d]);
        M[i][j] := M[i][j] + RandomNonzeroGF7_62B();
    od;

    return M;
end;;

