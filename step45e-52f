############################################################
# Corrected Hom basis function
############################################################

AltHomBasis45F := function(mats)
    local d, pdata, pairs, pairIndex, npairs, nvars, rows,
          A, p, i, j, k, r, s, l, q, coeff, row,
          basis, rankRows;

    d := Length(mats[1]);
    pdata := PairData45E(d);
    pairs := pdata.pairs;
    pairIndex := pdata.pairIndex;
    npairs := Length(pairs);
    nvars := npairs * d;

    rows := [];

    for A in mats do
        for p in [1..npairs] do
            i := pairs[p][1];
            j := pairs[p][2];

            for k in [1..d] do
                row := List([1..nvars], x -> zero45E);

                # left side: bracket(A e_i, A e_j)
                for r in [1..d] do
                    if A[i][r] <> zero45E then
                        for s in [1..d] do
                            if A[j][s] <> zero45E then
                                coeff := A[i][r] * A[j][s];

                                if r < s then
                                    q := pairIndex[r][s];
                                    row[VarIndex45E(q,k,d)] :=
                                        row[VarIndex45E(q,k,d)] + coeff;
                                elif r > s then
                                    q := pairIndex[s][r];
                                    row[VarIndex45E(q,k,d)] :=
                                        row[VarIndex45E(q,k,d)] - coeff;
                                fi;
                            fi;
                        od;
                    fi;
                od;

                # right side: bracket(e_i,e_j) A
                for l in [1..d] do
                    if A[l][k] <> zero45E then
                        row[VarIndex45E(p,l,d)] :=
                            row[VarIndex45E(p,l,d)] - A[l][k];
                    fi;
                od;

                Add(rows, row);
            od;
        od;
    od;

    rankRows := RankMat(rows);

    # Important correction:
    # rows encode equations R*x = 0.
    # GAP NullspaceMat gives left nullspace,
    # so use TransposedMat(rows) to get solution vectors x.
    basis := NullspaceMat(TransposedMat(rows));

    return rec(
        basis := basis,
        pairs := pairs,
        pairIndex := pairIndex,
        d := d,
        npairs := npairs,
        nvars := nvars,
        numRows := Length(rows),
        rankRows := rankRows
    );
end;;

