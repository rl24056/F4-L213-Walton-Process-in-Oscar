BlockDiag2_57 := function(A, B)
    local da, db, M, i, j;

    da := Length(A);
    db := Length(B);

    M := NullMat(da + db, da + db, F57);

    for i in [1..da] do
        for j in [1..da] do
            M[i][j] := A[i][j];
        od;
    od;

    for i in [1..db] do
        for j in [1..db] do
            M[da+i][da+j] := B[i][j];
        od;
    od;

    return M;
end;;

ImageV26_57 := function(pre)
