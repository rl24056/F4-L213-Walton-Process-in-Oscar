        Print("  f preserves S? ", PreservesForm52A(fM, S), "\n");
        Print("  t preserves S? ", PreservesForm52A(tM, S), "\n");
    fi;

    report := rec(
        label := label,
        dim := Mrec.dim,
        formDim := hdim,
        nonSingularCount := Length(good)
    );

    return report;
end;;

