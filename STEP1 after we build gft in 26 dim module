    Print("  dims = ", w62G.dims, "\n");
    Print("  lower dim = ", lowerdim62G, "\n");
    Print("  upper dim = ", Length(upperBasis62G), "\n");
    Print("  quotient dim = ", quotdim62G, "\n");

    if quotdim62G = 52 then

