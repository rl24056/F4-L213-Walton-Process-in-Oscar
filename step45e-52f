BracketFromHomVector51A := function(vec, d, data)
    local n, rows, p, k, row, pos;

    n := data.dim;
    rows := [];

    for p in [1..n] do
        row := [];

        for k in [1..d] do
            pos := (p-1)*d + k;
            Add(row, vec[pos]);
        od;

        Add(rows, row);
    od;

    return rows;
end;;

AddScaledVector51A := function(v, coeff, w)
    local i, out;

    out := ShallowCopy(v);

    for i in [1..Length(v)] do
        out[i] := out[i] + coeff*w[i];
    od;

    return out;
end;;

ZeroVector51A := function(d)
    return List([1..d], i -> zero45E);
end;;

UnitVector51A := function(d, i)
    local v;

    v := ZeroVector51A(d);
    v[i] := one45E;

    return v;
end;;

BracketOfBasis51A := function(bracketRows, i, j, data)
    local p, v;

    if i = j then
        return ZeroVector51A(data.d);
    fi;

    if i < j then
        p := data.index[i][j];
        return ShallowCopy(bracketRows[p]);
    else
        p := data.index[j][i];
        v := ShallowCopy(bracketRows[p]);
        return List(v, x -> -x);
    fi;
end;;

BracketOfVectors51A := function(bracketRows, v, w, data)
    local d, out, i, j, coeff, bij;

    d := data.d;
    out := ZeroVector51A(d);

    for i in [1..d] do
        if v[i] <> zero45E then
            for j in [1..d] do
                if w[j] <> zero45E then
                    coeff := v[i] * w[j];

                    if coeff <> zero45E then
                        bij := BracketOfBasis51A(bracketRows, i, j, data);
                        out := AddScaledVector51A(out, coeff, bij);
                    fi;
                fi;
            od;
        fi;
    od;

    return out;
end;;

JacobiFailureCount51A := function(bracketRows, data)
    local d, fails, i, j, k, ei, ej, ek,
          term1, term2, term3, jac;

    d := data.d;
    fails := 0;

    for i in [1..d-2] do
        for j in [i+1..d-1] do
            for k in [j+1..d] do
                ei := UnitVector51A(d, i);
                ej := UnitVector51A(d, j);
                ek := UnitVector51A(d, k);

                term1 := BracketOfVectors51A(
                    bracketRows,
                    ei,
                    BracketOfVectors51A(bracketRows, ej, ek, data),
                    data
                );

                term2 := BracketOfVectors51A(
                    bracketRows,
                    ej,
                    BracketOfVectors51A(bracketRows, ek, ei, data),
                    data
                );

                term3 := BracketOfVectors51A(
                    bracketRows,
                    ek,
                    BracketOfVectors51A(bracketRows, ei, ej, data),
                    data
                );

                jac := AddScaledVector51A(term1, one45E, term2);
                jac := AddScaledVector51A(jac, one45E, term3);

                if jac <> ZeroVector51A(d) then
                    fails := fails + 1;
                fi;
            od;
        od;
    od;

    return fails;
end;;

