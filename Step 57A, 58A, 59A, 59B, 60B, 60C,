Print("t in B? ", t57 in B57, "\n");
Print("Action exponent of t on <g> = ", ActionExponent57(g57, t57), "\n");
Print("Order(g*t) = ", Order(g57 * t57), "\n");
Print("|<g,f,t>| = ", Size(Group(g57, f57, t57)), "\n");

