        Print("  kac line = ", recg.kac_line, "\n");
        Print("------------------------------------------------------------\n");

        Print("g^13 = 1? ", g^13 = One52Ext32, "\n");
        Print("Trace(g)=0? ", TraceIsZero32(g), "\n");
        Print("Action exponent of f on <g> = ",
              ActionExponentOnGExt32(g, fExt32), "\n");

        BRecords := BuildBExtNormalForms32(g, fExt32);
        BMats := List(BRecords, x -> x.elt);
        distinctBCount := Length(DistinctMatrixList32(BMats));

        Print("Distinct normal forms g^i f^j = ", distinctBCount, "\n");

        basicGoodIndices := [];
        hitRecords := [];

        if distinctBCount = 78 then

            for idx in [1..Length(TraceMinus4ExactInvertersExt32)] do

                if idx mod 6 = 0 then
                    Print("  tested t-candidates up to index ", idx, "\n");
                fi;

                t := TraceMinus4ExactInvertersExt32[idx];

                actionT := ActionExponentOnGExt32(g, t);

                if actionT = fail then

                    if not MatrixInList32(t, BMats) then

                        Add(basicGoodIndices, idx);

                        witnesses := FastBruhatWitnesses32(g, fExt32, t);

                        if Length(witnesses) > 0 then

                            Add(
                                hitRecords,
                                rec(
                                    t_index := idx,
                                    first_witness := witnesses[1],
                                    all_fast_witnesses := witnesses
                                )
                            );

                            Print("FAST BRUHAT HIT FOUND!\n");
                            Print("  recovered line #", lineNo, "\n");
                            Print("  t index = ", idx, "\n");
                            Print("  first fast witness [i,j] = ", witnesses[1], "\n");
                            Print("  all fast witnesses = ", witnesses, "\n");

                        fi;

                    fi;

                fi;

            od;

        else
            Print("SKIP: B does not have 78 normal forms.\n");
        fi;

        Print("Basic external candidates = ", Length(basicGoodIndices), "\n");
        Print("Fast Bruhat hits = ", Length(hitRecords), "\n");

        Add(
            results,
            rec(
                recovered_line_number := lineNo,
                sign := recg.sign,
                kac_line := recg.kac_line,
                distinct_B_normal_forms := distinctBCount,
                basic_external_candidate_indices := basicGoodIndices,
                fast_bruhat_hits := hitRecords
            )
        );

    od;

    Print("\n============================================================\n");
    Print("FINAL REPORT: STEP 39B FAST BRUHAT\n");
    Print("============================================================\n");

    for r in results do
        Print("\nRecovered line #", r.recovered_line_number, "\n");
        Print("  sign = ", r.sign, "\n");
        Print("  kac line = ", r.kac_line, "\n");
        Print("  distinct B normal forms = ", r.distinct_B_normal_forms, "\n");
        Print("  basic external candidates = ",
              Length(r.basic_external_candidate_indices), "\n");
        Print("  fast Bruhat hits = ", Length(r.fast_bruhat_hits), "\n");

        if Length(r.fast_bruhat_hits) > 0 then
            Print("  first hit t index = ",
                  r.fast_bruhat_hits[1].t_index, "\n");
            Print("  first witness = ",
                  r.fast_bruhat_hits[1].first_witness, "\n");
        fi;
    od;

    return results;
end;;

