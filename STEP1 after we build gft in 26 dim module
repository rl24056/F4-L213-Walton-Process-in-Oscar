WitnessPairs62 := function(g, f, t)
    local out, i, j;
    out := [];
    for i in [0..12] do
        for j in [0..5] do
            if Order(g^i * f^j * t) = 3 then
                Add(out, [i,j]);
            fi;
        od;
    od;
    return out;
end;;

