############################################################
# Build invariant symmetric forms
#
# Row action convention:
#   row vector v maps to v*A.
#
# A bilinear form with matrix S is invariant if:
#
#   A * S * A^T = S
#
# because (vA) S (wA)^T = v (A S A^T) w^T.
############################################################

SymmetricIndex52A := function(d)
    local pairs, index, i, j;

    pairs := [];
    index := List([1..d], i -> List([1..d], j -> 0));

    for i in [1..d] do
        for j in [i..d] do
            Add(pairs, [i,j]);
            index[i][j] := Length(pairs);
            index[j][i] := Length(pairs);
        od;
    od;

    return rec(
        d := d,
        pairs := pairs,
        index := index,
        nvars := Length(pairs)
    );
end;;

SymVecToMat52A := function(vec, data)
    local d, S, k, i, j;

    d := data.d;
    S := List([1..d], i -> List([1..d], j -> zero45E));

    for k in [1..Length(data.pairs)] do
        i := data.pairs[k][1];
        j := data.pairs[k][2];

        S[i][j] := vec[k];
        S[j][i] := vec[k];
    od;

    return S;
end;;

InvariantSymmetricFormBasis52A := function(mats)
    local d, data, rows, A, i, j, p, q, row, var, r, s, coeff;

    d := Length(mats[1]);
    data := SymmetricIndex52A(d);
    rows := [];

    for A in mats do

        # Equation: A*S*A^T - S = 0
        # For each matrix entry (i,j), build linear equation in S variables.

        for i in [1..d] do
            for j in [1..d] do

                row := List([1..data.nvars], k -> zero45E);

                # Contribution from A*S*A^T:
                # (A*S*A^T)_{ij} = sum_{r,s} A[i][r] S[r][s] A[j][s]

                for r in [1..d] do
                    if A[i][r] <> zero45E then
                        for s in [1..d] do
                            if A[j][s] <> zero45E then
                                coeff := A[i][r] * A[j][s];
                                var := data.index[r][s];
                                row[var] := row[var] + coeff;
                            fi;
                        od;
                    fi;
                od;

                # Subtract S_{ij}
                var := data.index[i][j];
                row[var] := row[var] - one45E;

                Add(rows, row);
            od;
        od;
    od;

    return rec(
        data := data,
        basis := NullspaceMat(TransposedMat(rows)),
        equationRows := Length(rows),
        nvars := data.nvars,
        rankEquations := RankMat(rows)
    );
end;;

AllProjectiveCoeffs52A := function(dim)
    local F, elts, coeffs, a, b, c;

    F := GF(7);
    elts := Elements(F);
    coeffs := [];

    if dim = 1 then
        for a in elts do
            if a <> zero45E then
                Add(coeffs, [a]);
            fi;
        od;

    elif dim = 2 then
        for a in elts do
            for b in elts do
                if not (a = zero45E and b = zero45E) then
                    # projective normalisation
                    if a = one45E or (a = zero45E and b = one45E) then
                        Add(coeffs, [a,b]);
                    fi;
                fi;
            od;
        od;

    elif dim = 3 then
        for a in elts do
            for b in elts do
                for c in elts do
                    if not (a = zero45E and b = zero45E and c = zero45E) then
                        if a = one45E
                           or (a = zero45E and b = one45E)
                           or (a = zero45E and b = zero45E and c = one45E) then
                            Add(coeffs, [a,b,c]);
                        fi;
                    fi;
                od;
            od;
        od;

    else
        return fail;
    fi;

    return coeffs;
end;;

LinearComboVec52A := function(coeffs, basis)
    local out, i, k;

    out := List([1..Length(basis[1])], k -> zero45E);

    for i in [1..Length(coeffs)] do
        for k in [1..Length(out)] do
            out[k] := out[k] + coeffs[i] * basis[i][k];
        od;
    od;

    return out;
end;;

PreservesForm52A := function(A, S)
    return A * S * TransposedMat(A) = S;
end;;

TestInvariantFormsOneModule52A := function(label, Mrec)
    local inv, hdim, coeffsList, coeffs, vec, S, rank, good,
