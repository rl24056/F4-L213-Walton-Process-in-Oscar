    ext62G := ExtendLowerToUpper62G(lowerBasis62G, upperBasis62G);;

    lowerdim62G := Length(lowerBasis62G);;
    fulldim62G := Length(ext62G.full);;
    quotdim62G := fulldim62G - lowerdim62G;;

    Print("\nWindow ", wi62G, "\n");
