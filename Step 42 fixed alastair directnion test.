TestPair42B := function(idx12, idx14)
    local gens12, gens14, homdata12, homdata14;
    local H12, H14, hom12, hom14;
    local g12, f12, t12, B12;
    local g14, f14, t14, B14;
    local g26, f26, t26, H26, B26, wit26;

    gens12 := moduleLists42B[idx12];
    gens14 := moduleLists42B[idx14];

    homdata12 := BuildImageHomFromGens42B(H42B, gens12);
    homdata14 := BuildImageHomFromGens42B(H42B, gens14);

    H12 := homdata12.group;
    H14 := homdata14.group;

    hom12 := homdata12.hom;
    hom14 := homdata14.hom;

    g12 := Image(hom12, gH42B);
    f12 := Image(hom12, fH42B);
    t12 := Image(hom12, tH42B);
    B12 := Group(g12, f12);

    g14 := Image(hom14, gH42B);
    f14 := Image(hom14, fH42B);
    t14 := Image(hom14, tH42B);
    B14 := Group(g14, f14);

    g26 := BlockDiag2_42B(g12, g14);
    f26 := BlockDiag2_42B(f12, f14);
    t26 := BlockDiag2_42B(t12, t14);

    H26 := Group(g26, f26, t26);
    B26 := Group(g26, f26);
    wit26 := FindBruhatWitness42B(g26, f26, t26);

    return rec(
        idx12 := idx12,
        idx14 := idx14,

        H12 := H12,
        g12 := g12,
        f12 := f12,
        t12 := t12,
        B12 := B12,

        H14 := H14,
        g14 := g14,
        f14 := f14,
        t14 := t14,
        B14 := B14,

        H26 := H26,
        g26 := g26,
        f26 := f26,
        t26 := t26,
        B26 := B26,

        wit26 := wit26
    );
end;;

