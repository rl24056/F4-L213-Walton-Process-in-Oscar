                  "\n");

            if rank = Mrec.dim then
                Add(good, rec(coeffs := coeffs, rank := rank, S := S));
            fi;
        od;

        Print("Non-singular invariant forms found = ", Length(good), "\n");

    else
        Print("Too many invariant forms for brute-force projective search.\n");
    fi;

    gM := Img49A(Mrec, g45E);
    fM := Img49A(Mrec, f45E);
    tM := Img49A(Mrec, t45E);

    if Length(good) > 0 then
        S := good[1].S;

        Print("First non-singular form preservation checks:\n");
