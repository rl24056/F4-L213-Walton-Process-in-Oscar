############################################################
# PART 1. Basic helper functions
############################################################

TraceMat42B := function(A)
    local s, i;

    s := zero7_42B;

    for i in [1..Length(A)] do
        s := s + A[i][i];
    od;

    return s;
end;;

TraceLabelGeneral42B := function(x)
    if x = 0 * one7_42B then
        return "0";
    elif x = 1 * one7_42B then
        return "1";
    elif x = -1 * one7_42B then
        return "-1";
    elif x = 2 * one7_42B then
        return "2";
    elif x = -2 * one7_42B then
        return "-2";
    elif x = -4 * one7_42B then
        return "-4";
    else
        return String(x);
    fi;
end;;

TraceLabel26_42B := function(x)
    if x = 0 * one7_42B then
        return "0";
    elif x = 1 * one7_42B then
        return "1";
    elif x = -1 * one7_42B then
        return "-1";
    elif x = 2 * one7_42B then
        return "2";
    elif x = -2 * one7_42B then
        return "-2";
    else
