SubAction62H := function(B, Gen)
    local Act, v, coeffs, row, i, j;

    Act := [];

    for i in [1..Length(B)] do
        v := B[i] * Gen;
        coeffs := SolutionMat(B, v);

        if coeffs = fail then
            Error("SubAction62H failed: vector not in supplied basis span.");
        fi;

        row := [];

        for j in [1..Length(B)] do
            Add(row, coeffs[j]);
        od;

        Add(Act, row);
    od;

    return Act;
end;;

ProfileOnBasis62H := function(B)
    local A, F, T;

    if Length(B) = 0 then
        return [0,0,0,0,0,0,0];
    fi;

    A := SubAction62H(B, EndG62E);
    F := SubAction62H(B, EndF62E);
    T := SubAction62H(B, EndT62E);

    return [
        Length(B),
        TraceSigned62E(A),
        TraceSigned62E(F),
        TraceSigned62E(F^2),
        TraceSigned62E(F^3),
        TraceSigned62E(T),
        TraceSigned62E(A*T)
    ];
end;;

