                out := BasisVec59(27, 1);

            elif i = 1 then
                out := BasisVec59(27, j);

            elif j = 1 then
                out := BasisVec59(27, i);

            elif i >= 2 and i <= 13 and j >= 2 and j <= 13 then
                a := i - 1;
                b := j - 1;
