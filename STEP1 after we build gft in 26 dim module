SignedGF7_62 := function(x)
    local n;
    for n in [-3..3] do
        if x = n * One(F62) then
            return n;
        fi;
    od;
    return x;
end;;

TraceMat62 := function(A)
    local s, i, d;
    d := Length(A);
    s := Zero(F62);
    for i in [1..d] do
        s := s + A[i][i];
    od;
    return s;
end;;

TraceSigned62 := function(A)
    return SignedGF7_62(TraceMat62(A));
end;;

MatDim62 := function(A)
    return Length(A);
end;;

PrintListWithLabel62 := function(label, L)
