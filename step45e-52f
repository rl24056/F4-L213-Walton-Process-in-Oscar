############################################################

SymPowerMatrix46A := function(A, data)
    local d, deg, n, supps, rows, bidx, mon, row,
          a, b, c, rr, ss, tt, coeff, tup, q;

    d := data.d;
    deg := data.degree;
    n := data.dim;

    supps := RowSupports46A(A);
