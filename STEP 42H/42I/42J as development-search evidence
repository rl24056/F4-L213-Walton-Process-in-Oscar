end;;

############################################################
# PART 3. Build synchronised 26D groups
############################################################

BuildSync26Group42H := function(idx14)
    local gens12, gens14, gens26, k, H12, H14, H26;

    gens12 := moduleRecords42H[idx12_42H].generators;
    gens14 := moduleRecords42H[idx14].generators;

    gens26 := [];

    for k in [1..Length(gens12)] do
        Add(gens26, BlockDiag2_42H(gens12[k], gens14[k]));
    od;

    H12 := Group(gens12);
    H14 := Group(gens14);
    H26 := Group(gens26);

    return rec(
        idx14 := idx14,
        gens12 := gens12,
        gens14 := gens14,
        gens26 := gens26,
        H12 := H12,
        H14 := H14,
        H26 := H26
    );
end;;

############################################################
# PART 4. Direct enumeration Walton search
############################################################

FindWaltonTriplesDirect42H := function(HM, modelLabel, maxHits)
    local sizeHM, elts, order13s, order6s, invols;
    local L, g, fRaw, f, action, B, t, wit, generatedSize;
    local countG, countF, targetOk, nf, expUsed;

    sizeHM := Size(HM);
    elts := Elements(HM);

    order13s := Filtered(elts, x -> Order(x) = 13);
    order6s := Filtered(elts, x -> Order(x) = 6);
    invols := Filtered(elts, x -> Order(x) = 2);

    Print("\nDirect search in ", modelLabel, "\n");
    Print("  Size(HM)         = ", sizeHM, "\n");
    Print("  total elements   = ", Length(elts), "\n");
    Print("  order-13 elements= ", Length(order13s), "\n");
    Print("  order-6 elements = ", Length(order6s), "\n");
    Print("  involutions      = ", Length(invols), "\n");

    L := [];
    countG := 0;

    for g in order13s do
        countG := countG + 1;

        if countG mod 20 = 0 then
            Print("  progress: g-count = ", countG,
                  " / ", Length(order13s),
                  ", hits = ", Length(L),
                  ", Runtime ms = ", Runtime(), "\n");
        fi;

        for fRaw in order6s do
            action := ActionExponentCyclic42H(g, fRaw);

            if action = 10 or action = 4 then

                if action = 10 then
                    f := fRaw;
                    expUsed := 10;
                else
                    f := fRaw^-1;
                    expUsed := 10;
                fi;

                if ActionExponentCyclic42H(g, f) = 10 then
                    B := Group(g, f);

                    if Size(B) = 78 then
                        nf := NormalFormsCount42H(g, f);

                        if nf = 78 then
                            for t in invols do
                                if f^t = f^-1
                                   and not (t in B)
                                   and ActionExponentCyclic42H(g, t) = fail then

                                    wit := FindBruhatWitness42H(g, f, t);

                                    if wit <> fail then
                                        generatedSize := Size(Group(g, f, t));

                                        if generatedSize = sizeHM then
                                            targetOk := IsTarget26Trace42H(g, f, t);

                                            Add(L, rec(
                                                g := g,
                                                f := f,
                                                t := t,
                                                B := B,
                                                witness := wit,
                                                targetTrace := targetOk,
                                                normalForms := nf
                                            ));

                                            Print("\n  HIT #", Length(L),
                                                  " in ", modelLabel, "\n");
                                            Print("    target 26D trace? ", targetOk, "\n");
                                            Print("    action exponent f on <g> = ",
                                                  ActionExponentCyclic42H(g, f), "\n");
                                            Print("    witness b = g^", wit.i,
                                                  " * f^", wit.j, "\n");
                                            Print("    Order(b*t) = ",
                                                  Order((g^wit.i * f^wit.j) * t), "\n");
                                            Print("    Order(g*t) = ", Order(g*t), "\n");
                                            Print("    Size(B) = ", Size(B), "\n");
                                            Print("    normal forms in B = ", nf, "\n");
                                            Print("    Size(<g,f,t>) = ", generatedSize, "\n");
                                            Print("    Trace profile 26D:\n");
                                            PrintTraceProfile26_42H(g, f, t);

                                            if Length(L) >= maxHits then
                                                return L;
                                            fi;
                                        fi;
                                    fi;
                                fi;
                            od;
                        fi;
                    fi;
                fi;
            fi;
        od;
    od;

    return L;
end;;

