############################################################
# Annihilator:
#   Ann(A) = { v | v*w = 0 for all w }
#
# Since product is commutative, left annihilator is enough.
############################################################

AnnihilatorBasis60C := function(prod)
    local d, rows, i, j, k, row, varIndex;

    d := 27;

    varIndex := function(i)
        return i;
    end;

    rows := [];

    # Unknown v = sum_i x_i e_i.
    # For every basis e_j and coordinate k:
    #   sum_i x_i * prod[i][j][k] = 0.
    for j in [1..d] do
        for k in [1..d] do
            row := List([1..d], x -> zero60C);

            for i in [1..d] do
                if prod[i][j][k] <> zero60C then
                    row[varIndex(i)] := row[varIndex(i)] + prod[i][j][k];
                fi;
            od;

            Add(rows, row);
        od;
    od;

    return NullspaceMat(rows);
end;;

