    fi;
end;;

TraceLabel52_42F := function(x)
    if x = 0 * one7_42F then
        return "0";
    elif x = 2 * one7_42F then
        return "2";
    elif x = -2 * one7_42F then
        return "-2";
    elif x = -4 * one7_42F then
        return "-4";
    else
        return String(x);
    fi;
end;;

ActionExponentCyclic42F := function(g, x)
    local gx, k, n;

    n := Order(g);
    gx := g^x;

    for k in [0..n-1] do
        if gx = g^k then
            return k;
        fi;
    od;

    return fail;
end;;

FindBruhatWitness42F := function(g, f, t)
    local i, j, b, bt;

    for i in [0..12] do
        for j in [0..5] do
            b := g^i * f^j;
            bt := b * t;

            if bt <> bt^0 and bt^3 = bt^0 then
                return rec(i := i, j := j, order := Order(bt));
            fi;
        od;
    od;

    return fail;
end;;

NormalFormsCount42F := function(g, f)
    local L, i, j;

    L := [];

    for i in [0..12] do
        for j in [0..5] do
            Add(L, g^i * f^j);
        od;
    od;

    return Length(Set(L));
end;;

BlockDiag2_42F := function(A, B)
    local n, m, C, i, j;

    n := Length(A);
    m := Length(B);

    C := NullMat(n + m, n + m, F7_42F);

    for i in [1..n] do
        for j in [1..n] do
            C[i][j] := A[i][j];
        od;
    od;

    for i in [1..m] do
        for j in [1..m] do
            C[n+i][n+j] := B[i][j];
        od;
    od;

    return C;
end;;

IsBlockDiagonalAt42F := function(A, d)
    local n, i, j, z;

    n := Length(A);
    z := 0 * A[1][1];

    for i in [1..d] do
        for j in [d+1..n] do
            if A[i][j] <> z then
                return false;
            fi;
        od;
    od;

    for i in [d+1..n] do
        for j in [1..d] do
            if A[i][j] <> z then
                return false;
            fi;
        od;
    od;

    return true;
end;;

BuildImageHom42F := function(H, sourceGens, moduleRecord)
    local imageGens, HM, hom;

    imageGens := moduleRecord.generators;
    HM := Group(imageGens);

    hom := GroupHomomorphismByImages(H, HM, sourceGens, imageGens);

    return rec(group := HM, hom := hom);
end;;

############################################################
# PART 2. Abstract PSL2(13) Walton triple
############################################################

FindAbstractWaltonTriple42F := function(H)
    local elts, invols, order13s, g, P, N, f, B, t, wit, best;

    elts := Elements(H);
    invols := Filtered(elts, x -> Order(x) = 2);
    order13s := Filtered(elts, x -> Order(x) = 13);

    best := fail;

    Print("Abstract search: order-13 elements = ", Length(order13s), "\n");
    Print("Abstract search: involutions = ", Length(invols), "\n");

    for g in order13s do
        P := Group(g);
        N := Normalizer(H, P);

        for f in Elements(N) do
            if Order(f) = 6 and ActionExponentCyclic42F(g, f) = 10 then
                B := Group(g, f);

                if Size(B) = 78 then
                    for t in invols do
                        if f^t = f^-1
                           and not (t in B)
                           and ActionExponentCyclic42F(g, t) = fail
                           and Size(Group(g, f, t)) = Size(H) then

                            wit := FindBruhatWitness42F(g, f, t);

                            if wit <> fail then
                                if wit.i = 1 and wit.j = 0 then
                                    return rec(
                                        g := g,
                                        f := f,
                                        t := t,
                                        B := B,
                                        witness := wit
                                    );
                                fi;

                                if best = fail then
                                    best := rec(
                                        g := g,
                                        f := f,
                                        t := t,
                                        B := B,
                                        witness := wit
                                    );
                                fi;
                            fi;
                        fi;
                    od;
                fi;
            fi;
        od;
    od;

    return best;
end;;

