            local i, first;

            Print("\n", name, "\n");
            Print("  target vector = ", vec, "\n");

            if sol = fail then
                Print("  SolutionMat failed.\n");
                return;
            fi;

            Print("  coefficients = ", sol, "\n");
            Print("  decomposition: ");

            first := true;

            for i in [1..Length(sol)] do
                if sol[i] <> 0 then
                    if first = false then
                        Print(" + ");
                    fi;

                    Print(sol[i], "*irr#", i,
                          "(deg ", irr43E[i][1], ")");

                    first := false;
                fi;
            od;

            if first = true then
                Print("0");
            fi;

            Print("\n");
        end;;

        matIrr43E := List(irr43E, chi -> List(chi, x -> x));;

        ############################################################
        # PART 4. Decompose target vectors
        ############################################################

        Print("\n============================================================\n");
        Print("PART 4: DECOMPOSITIONS BY SOLUTIONMAT\n");
        Print("============================================================\n");

        sol12_43E := SolutionMat(matIrr43E, vec12_43E);;
        sol14_43E := SolutionMat(matIrr43E, vec14_43E);;
        sol26_43E := SolutionMat(matIrr43E, vec26_43E);;
        sol38_43E := SolutionMat(matIrr43E, vec38_43E);;
        sol52_43E := SolutionMat(matIrr43E, vec52_43E);;

        PrintSol43E("V12", vec12_43E, sol12_43E);
        PrintSol43E("V14 record #4", vec14_43E, sol14_43E);
        PrintSol43E("V26 = 12 + 14", vec26_43E, sol26_43E);
        PrintSol43E("V38 = 12 + 12 + 14", vec38_43E, sol38_43E);
        PrintSol43E("V52 = 2*12 + 2*14", vec52_43E, sol52_43E);

        ############################################################
