FindBruhatWitness42I := function(g, f, t)
    local i, j, b, bt, id;

    id := t^0;

    for i in [0..12] do
        for j in [0..5] do
            b := g^i * f^j;
            bt := b * t;

            if bt <> id and bt^3 = id then
                return rec(i := i, j := j, order := Order(bt));
            fi;
        od;
    od;

    return fail;
end;;

NormalFormsCount42I := function(g, f)
