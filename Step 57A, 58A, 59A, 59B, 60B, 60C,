BuildSymPairData59 := function(d)
    local pairs, pairIndex, i, j, idx;

    pairs := [];
    pairIndex := [];

    for i in [1..d] do
        pairIndex[i] := [];
    od;

    idx := 0;

    for i in [1..d] do
        for j in [i..d] do
            idx := idx + 1;
            Add(pairs, [i,j]);
            pairIndex[i][j] := idx;
            pairIndex[j][i] := idx;
        od;
    od;

    return rec(
        pairs := pairs,
        pairIndex := pairIndex,
        dim := Length(pairs)
    );
end;;

SymmetricSquareMat59 := function(A)
    local d, pdata, pairs, pairIndex, sdim, S,
          p, i, j, r, s, q, coeff;

    d := Length(A);
    pdata := BuildSymPairData59(d);
    pairs := pdata.pairs;
    pairIndex := pdata.pairIndex;
    sdim := pdata.dim;

    S := NullMat(sdim, sdim, F59);

    for p in [1..sdim] do
        i := pairs[p][1];
        j := pairs[p][2];

        for r in [1..d] do
            if A[i][r] <> zero59 then
                for s in [1..d] do
                    if A[j][s] <> zero59 then
                        coeff := A[i][r] * A[j][s];
                        q := pairIndex[r][s];
                        S[p][q] := S[p][q] + coeff;
                    fi;
                od;
            fi;
        od;
    od;

    return S;
end;;

TensorMat59 := function(A, B)
    local da, db, T, i, j, r, s, row, col, coeff;

    da := Length(A);
    db := Length(B);

    T := NullMat(da*db, da*db, F59);

    for i in [1..da] do
        for j in [1..db] do
            row := (i-1)*db + j;

            for r in [1..da] do
                if A[i][r] <> zero59 then
                    for s in [1..db] do
                        if B[j][s] <> zero59 then
                            col := (r-1)*db + s;
                            coeff := A[i][r] * B[j][s];
                            T[row][col] := T[row][col] + coeff;
                        fi;
                    od;
                fi;
            od;
        od;
    od;

    return T;
end;;

